{
  "name": "@perfectory/dawneer-web",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../../../platforms/foundation-platform/docs/openapi/lineage-review.v1.json -o src/api/foundation.d.ts && openapi-typescript ../../../platforms/foundation-platform/docs/openapi/catalog.v1.json -o src/api/catalog.d.ts && openapi-typescript ../../../platforms/foundation-platform/docs/openapi/data-catalog.v1.json -o src/api/data-catalog.d.ts",
    "api:check": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.12.0",
    "elkjs": "0.12.2",
    "es-toolkit": "^1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
