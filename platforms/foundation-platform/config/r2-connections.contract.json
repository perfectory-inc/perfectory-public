{
  "schema_version": 2,
  "provider": "cloudflare-r2",
  "environment": "production",
  "purpose": "Non-secret R2 connection metadata and environment-key contract for Foundation Platform.",
  "profile_gateway": {
    "worker_name": "foundation-profile-gateway",
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "gold/industrial-complex/profiles",
      "artifact_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
      "suffix": ".json"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=31536000, immutable"
  },
  "parcel_by_pnu_gateway": {
    "worker_name": "foundation-parcel-gateway",
    "public_hostname": "catalog.perfectory.io",
    "public_hostname_aliases": [
      "catalog.gongzzang.app"
    ],
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "serving/parcels/by-pnu",
      "generation_dir_pattern": "v[1-9][0-9]{0,17}",
      "patch_dir_pattern": "p[1-9][0-9]{0,17}",
      "pnu_pattern": "[0-9]{10}[1289][0-9]{8}",
      "suffix": ".json",
      "manifest_object": "serving/parcels/by-pnu/manifest.json",
      "manifest_history_dir": "serving/parcels/by-pnu/manifest-history"
    },
    "request_path": {
      "prefix": "/parcels/by-pnu/",
      "capabilities": "/parcels/by-pnu/_capabilities"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=3600",
    "manifest_cache_control": "no-cache, max-age=0",
    "manifest_edge_cache_seconds": 60
  },
  "connections": {
    "lakehouse": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_ACCOUNT_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_ENDPOINT",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_BUCKET",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_REGION",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_READER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_PARCEL_PUBLICATION_EVIDENCE_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_PARCEL_PUBLICATION_EVIDENCE_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_BUCKET": "foundation-platform-lakehouse-prod",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_REGION": "auto"
      }
    },
    "tile_derivatives": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_ACCOUNT_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_ENDPOINT",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_BUCKET",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_REGION",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_READER_SECRET_ACCESS_KEY"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_BUCKET": "foundation-platform-tile-derivatives-prod",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_REGION": "auto",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX": "gold/vector-tiles/releases"
      }
    },
    "postgres_recovery": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_BUCKET",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_ENDPOINT_HOST",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_READER_SECRET_ACCESS_KEY"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_BUCKET": "foundation-platform-postgres-recovery-prod"
      }
    }
  },
  "by_pnu_serving_patches": {
    "decision": "docs/adr/0141-by-pnu-serving-publishes-changed-documents-as-patch-generations.md",
    "manifest_schema_version": 2,
    "max_patches": 7,
    "manifest_patch_ceiling": 64,
    "max_cumulative_change_ratio": 0.05,
    "max_delta_fraction": 0.5,
    "pnu_prefix_length": 5,
    "tombstone_schema_version": "foundation-platform.by_pnu_serving_tombstone.v1",
    "tombstone_max_bytes": 512
  },
  "by_pnu_section_packs": {
    "decision": "docs/adr/0147-by-pnu-documents-are-served-from-section-packs.md",
    "magic": "FPNUPACK",
    "format_version": 1,
    "manifest_section_packs_schema_version": 3,
    "unit_prefix_length": 10,
    "compression": "gzip",
    "suffix": ".pack",
    "generation_dir_pattern": "g[1-9][0-9]{0,17}",
    "patch_dir_pattern": "p[1-9][0-9]{0,17}",
    "content_type": "application/octet-stream",
    "cache_control": "public, max-age=31536000, immutable",
    "max_index_entries": 1000000,
    "preview_query_parameter": "packs",
    "cloudflare_analytics": {
      "env_file": "/etc/foundation-platform/cloudflare-analytics.env",
      "account_id_env": "FOUNDATION_PLATFORM_CLOUDFLARE_ACCOUNT_ID",
      "api_token_env": "FOUNDATION_PLATFORM_CLOUDFLARE_ANALYTICS_TOKEN",
      "zone_id_env": "FOUNDATION_PLATFORM_CLOUDFLARE_ZONE_ID",
      "token_scope": "Account Analytics: Read",
      "reason": "the gate reads the preview Worker's CPU and cut-offs from Workers analytics; the token is read only through the unit's EnvironmentFile (root:root 0600), never from the repository or a shell"
    },
    "read_path": {
      "whole_pack_max_bytes": 262144,
      "whole_pack_max_bytes_reason": "g1 measurement 2026-10-05 (76,040 packs): 93.1% of packs and 62.3% of document reads fall in packs of at most 256 KiB; such a pack is read whole in the GET that finds its head (one R2 hop), a larger one as head + range",
      "memory_budget_bytes": 33554432,
      "r2_attempts": 3,
      "r2_retry_base_ms": 40,
      "r2_deadline_ms": 6000
    },
    "cutover_gate": {
      "evidence_schema_version": "foundation-platform.by_pnu_section_pack_gate_evidence.v1",
      "latency_sample_size": 10000,
      "sample_seed": "foundation-platform.section-pack-cutover.v1",
      "sample_candidates_per_million": 2000,
      "probe_concurrency": 8,
      "probe_concurrency_reason": "the 2026-10-05 sequential probe took 3h45m for 10,000 PNUs; 8 requests in flight finish the sample within 30 minutes while each read is still timed on its own",
      "worker_cpu_p99_max_ms": 5,
      "worker_cpu_reason": "the account runs Workers Free (10 ms CPU per request); on 2026-10-05 the preview's pack path (CPU p50 8.0 ms, p99 19.8 ms) hit 325 exceededResources (error 1102, HTTP 503) in 11 minutes. The gate demands half the limit at p99 and no exceededResources, read from Workers analytics for the probe window",
      "slo": {
        "availability_min": 0.9995,
        "availability_reason": "the owner's bound for the pack path: at most one non-200 answer in 2,000 for PNUs the lane serves, counted over the paired probe and the load phase",
        "latency_max_increase_ms": {
          "cold": { "p50": 50, "p95": 50, "p99": 150 },
          "warm": { "p50": 50, "p95": 50, "p99": 150 }
        },
        "latency_reason": "the pack path may not be noticeably slower than the object path it replaces: 50 ms at p50 and p95 is below a perceptible panel delay; p99 gets 150 ms because the tail is dominated by the client-to-edge path (2026-10-05: ai-server to LAX p95 3-4 s on both routes)"
      },
      "load_test": {
        "requests_per_second": 25,
        "duration_seconds": 600,
        "max_in_flight": 64,
        "reason": "25 requests/s for 10 minutes is 15,000 reads, the Workers Free daily cap (100,000) compressed into a tenth of an hour, and above any launch-day panel rate the product has planned; the PNUs are the gate sample drawn with replacement, so legal dongs repeat and the mix holds cold and warm reads"
      }
    }
  },
  "building_by_pnu_gateway": {
    "worker_name": "foundation-building-gateway",
    "public_hostname": "buildings.perfectory.io",
    "public_hostname_aliases": [
      "buildings.gongzzang.app"
    ],
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "serving/buildings/by-pnu",
      "generation_dir_pattern": "v[1-9][0-9]{0,17}",
      "patch_dir_pattern": "p[1-9][0-9]{0,17}",
      "pnu_pattern": "[0-9]{10}[1289][0-9]{8}",
      "suffix": ".json",
      "manifest_object": "serving/buildings/by-pnu/manifest.json",
      "manifest_history_dir": "serving/buildings/by-pnu/manifest-history"
    },
    "request_path": {
      "prefix": "/buildings/by-pnu/",
      "capabilities": "/buildings/by-pnu/_capabilities"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=3600",
    "manifest_cache_control": "no-cache, max-age=0",
    "manifest_edge_cache_seconds": 60,
    "section_packs": {
      "root": "serving/buildings/packs",
      "sections": [
        "documents"
      ],
      "anchor_section": "documents",
      "preview_binding": "FOUNDATION_PLATFORM_BUILDING_PACK_PREVIEW",
      "serving_binding": "FOUNDATION_PLATFORM_BUILDING_PACK_SERVING",
      "serving_binding_reason": "a Worker version whose binding is off answers from objects even when the manifest names section packs, so the pack path is rolled out by version percentage (the canary) and rolled back by moving traffic, with the manifest left as it is",
      "canary": {
        "steps_percent": [1, 10, 50, 100],
        "hold_seconds": 900,
        "min_requests_per_step": 200,
        "reason": "Cloudflare gradual deployments split by request; 15 minutes per step lets Workers analytics (one to two minutes behind) count at least min_requests_per_step on the new version before its error rate, CPU and wall time are compared with the old one"
      },
      "monitor": {
        "pnus": 20,
        "latency_p95_max_ms": 3000,
        "reason": "hourly (infra/systemd/foundation-building-serving-monitor.timer), 20 PNUs from the gate sample read from the live hostname and compared with the object documents while they exist: a 5xx, a document that differs from its object, or a p95 above what the ai-server-to-edge path shows on a good hour (2026-10-05: about 1-3 s) is an alert"
      },
      "fallback": {
        "objects_kept_clean_days": 30,
        "reason": "the object lane stays published and restorable (manifest revert) until the monitor has been clean this long after the cut-over; retiring objects is a separate owner decision and objects are never deleted without it (append-only)"
      },
      "preview_worker": {
        "wrangler_env": "preview",
        "worker_name": "foundation-building-gateway-preview",
        "public_hostname": "buildings-preview.perfectory.io"
      },
      "scheduled_bake": {
        "job": "by_pnu_serving_bake",
        "capability": "building_section_pack_patches"
      }
    }
  },
  "vector_tile_gateway": {
    "worker_name": "foundation-tile-gateway",
    "public_hostname": "tiles.perfectory.io",
    "public_hostname_aliases": [
      "tiles.gongzzang.app"
    ],
    "connection": "tile_derivatives",
    "r2_binding": "FOUNDATION_PLATFORM_TILE_DERIVATIVES",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": {
        "expected_value": "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX"
      },
      "source_id_pattern": "[a-z][a-z0-9_]{0,63}-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
      "suffix": ".pmtiles"
    },
    "max_zoom": 24,
    "content_type": "application/vnd.mapbox-vector-tile",
    "cache_control": "public, max-age=31536000, immutable",
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    }
  },
  "map_edit_gateway": {
    "worker_name": "foundation-map-edit-gateway",
    "public_hostname": "map-edits.perfectory.io",
    "public_hostname_aliases": [],
    "d1_binding": "FOUNDATION_PLATFORM_MAP_EDITS",
    "d1_database_name": "foundation-map-edits",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "write_token_binding": "FOUNDATION_PLATFORM_MAP_EDIT_WRITE_TOKEN",
    "compatibility_date": "2026-04-26",
    "units": {
      "complex": {
        "feature_id_property": "complex_id",
        "feature_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        "properties": {
          "official_complex_code": "string"
        }
      },
      "admin": {
        "feature_id_property": "administrative_unit_id",
        "feature_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        "properties": {
          "scope_kind": "string",
          "canonical_code": "string",
          "display_name": "string"
        }
      }
    },
    "geometry": {
      "types": [
        "Polygon",
        "MultiPolygon"
      ],
      "bounds_wgs84": [124.0, 32.9, 132.0, 38.9], "bounds_wgs84_review": "public-repository-safety: reviewed-runtime-coordinate — the national extent an edit must fall inside, not a place",
      "max_vertices": 20000,
      "max_body_bytes": 1048576
    },
    "max_pending_edits_per_unit": 5000,
    "overlay_cache_control": "public, max-age=0, must-revalidate",
    "content_type": "application/json; charset=utf-8",
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    }
  }
}
