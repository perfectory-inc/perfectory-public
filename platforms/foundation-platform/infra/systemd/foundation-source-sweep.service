[Unit]
Description=Foundation Platform daily source sweep (ADR-0077)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/daily-source-sweep.sh
# A bound, not a budget (root ADR-0172): a backlog of ~40 GB may outlast one run; files commit one by
# one, so a run stopped here resumes next time. Airflow timeout_minutes (jobs.v1.json) stays above it.
TimeoutStartSec=8h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The VWorld lane spools each provider body on the data disk while it is hashed (root ADR-0168);
# the root disk holding the state directory is small.
ReadWritePaths=/var/lib/foundation-platform/source-sweep /data/foundation-platform/source-sweep

[Install]
WantedBy=multi-user.target
