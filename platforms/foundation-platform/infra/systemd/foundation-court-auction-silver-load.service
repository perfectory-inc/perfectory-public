[Unit]
Description=Foundation Platform 법원경매정보, the Silver half: give each row a PNU by address and load silver.court_auction_item and silver.court_auction_sale_result (root ADR-0280)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/court-auction.md
X-Foundation-Owner=lakehouse
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/court-auction-silver-load.sh
TimeoutStartSec=90m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/court-auction
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0454); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
