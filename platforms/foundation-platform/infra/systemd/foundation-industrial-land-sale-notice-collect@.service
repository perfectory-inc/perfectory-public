[Unit]
Description=Foundation Platform 산업용지 분양·처분·공급 공고와 첨부 (%i), the collection half: ask the notices the lakehouse does not record as read, store every attachment once in the shared media store, land the details in Bronze (root ADR-0603)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/industrial-land-sale-notice.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=-/etc/foundation-platform/operations-map.env
EnvironmentFile=-/etc/foundation-platform/data-go-kr.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-land-sale-notice-collect.sh %i
# The job list's longest time_limit_minutes (jobs.v1.json): Factory-on's, from its measured full
# history asked back to back (about 3,900 s, 2026-11-22); ILIS's and LH's 40 minutes and KICOX's hour
# are their drop-ins (root ADR-0574 §8; no run has a count or time cap of its own, root ADR-0603
# 2026-11-23 revision).
TimeoutStartSec=2h
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-land-sale-notice
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
