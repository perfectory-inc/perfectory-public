FROM rust:1.99.1-bookworm@sha256:665b6e0a9290a7298236c08c6e4f1e754e3f0d9b70421c434daa3dfba888d63e AS chef

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /src

# rdkafka-sys (the Foundation outbox Kafka broadcaster) builds vendored librdkafka and needs a C/C++
# toolchain beyond the rust image default. The court auction browser sessions (wreq, root
# ADR-0289 §1) build BoringSSL with cmake and generate its bindings with libclang.
RUN apt-get update \
    && apt-get install -y --no-install-recommends         cmake=3.25.1-1         pkg-config=1.8.1-1         libssl-dev=3.0.22-1~deb12u1         zlib1g-dev=1:1.2.13.dfsg-1         libclang-dev=1:14.0-55.7~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

# cargo-chef splits the build into a dependency layer keyed only by Cargo.lock and the
# manifests, and the workspace's own code (root ADR-0155). The release admission keeps that
# layer in a content-addressed BuildKit cache, so a release whose lockfile did not change
# reuses the bundled DuckDB C++ build instead of spending ~40 minutes on it again.
# BuildKit checks each archive against its pinned digest before the layer exists. One archive per
# platform the image is built for: linux/amd64 for the data host's release, linux/arm64 for the AWS
# images (root ADR-0619 §7); the build unpacks the one TARGETARCH names and refuses any other.
ARG TARGETARCH
ADD --checksum=sha256:aca691abfbfbbe00d482e0ed2249eec3091b65e96a0ce92947fb5b254d48b16d \
    https://github.com/LukeMathWalker/cargo-chef/releases/download/v0.1.78/cargo-chef-x86_64-unknown-linux-musl.tar.xz \
    /tmp/cargo-chef-amd64.tar.xz
ADD --checksum=sha256:cd59b90fce5fa84c4189648fec33404ec5491791eebdb812df5e7fca8336408d \
    https://github.com/LukeMathWalker/cargo-chef/releases/download/v0.1.78/cargo-chef-aarch64-unknown-linux-musl.tar.xz \
    /tmp/cargo-chef-arm64.tar.xz
RUN case "${TARGETARCH}" in amd64) triple=x86_64 ;; arm64) triple=aarch64 ;; *) exit 1 ;; esac \
    && tar -xJf "/tmp/cargo-chef-${TARGETARCH}.tar.xz" -C /usr/local/cargo/bin --strip-components=1 \
        "cargo-chef-${triple}-unknown-linux-musl/cargo-chef" \
    && rm /tmp/cargo-chef-amd64.tar.xz /tmp/cargo-chef-arm64.tar.xz

# Toolchain pin is the base image tag (the rust: tag, guard-enforced); root
# rust-toolchain.toml is outside this context, cargo uses the image default (tools/technology-versions.contract.json rust_toolchain).
FROM chef AS planner
COPY Cargo.toml Cargo.lock /src/
COPY crates /src/crates
COPY config /src/config
COPY services /src/services
COPY schemas /src/schemas
COPY contracts /src/contracts
COPY infra/lakehouse/contracts /src/infra/lakehouse/contracts
RUN cargo chef prepare --recipe-path /src/recipe.json

FROM chef AS rust-builder
# The release admission passes the job count from tools/release-build.contract.json (ADR-0137).
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
COPY --from=planner /src/recipe.json /src/recipe.json
RUN cargo chef cook --locked --release -p foundation-outbox-publisher --recipe-path /src/recipe.json

COPY Cargo.toml Cargo.lock /src/
COPY crates /src/crates
COPY config /src/config
COPY services /src/services
COPY schemas /src/schemas
# contracts/ holds the schema registry the publisher compiles in (include_str!, root ADR-0336).
COPY contracts /src/contracts
# Only the part of infra/ the Rust code compiles in (include_str! of the lakehouse contracts). The
# Spark jobs, compose files and units beside it are not inputs of this build: copying all of infra/
# rebuilt the publisher for a Spark .py change (2026-10-27, #881: 351 s) (root ADR-0309).
COPY infra/lakehouse/contracts /src/infra/lakehouse/contracts

RUN cargo build --locked --release -p foundation-outbox-publisher

FROM debian:bookworm-slim@sha256:e67eeead736ff7bbe258ef088bff683635c561b1fcfefad0806c1df4ab49ce0e

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /workspace

COPY --from=rust-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=rust-builder /src/target/release/foundation-outbox-publisher /usr/local/bin/foundation-outbox-publisher

USER 10001:10001
ENTRYPOINT ["foundation-outbox-publisher"]
