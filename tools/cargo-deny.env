# Pinned cargo-deny release every CI supply-chain job installs (root ADR-0152).
# scripts/ci/install-cargo-deny.sh is the only reader; it checks the archive's
# SHA-256 before extracting it. A prebuilt binary replaces `cargo install`, which
# compiled cargo-deny from crates.io in every run and is the step that failed on
# 2026-10-06 with the HTTP/2 framing error.
CARGO_DENY_VERSION=0.19.8
CARGO_DENY_LINUX_AMD64_SHA256=70e769ae3872e34d45132b17040859175e11401dc12dddb0303e0b8c7d088f3f
