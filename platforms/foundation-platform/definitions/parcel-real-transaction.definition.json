    {
      "id": "gold_parcel_real_transaction_rebuild",
      "scope": "changed-keys",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "실거래 kind Gold (root ADR-0350, ADR-0371; scripts/ops/gold-panel-rebuild.sh parcel-real-transaction): gold.parcel_real_transaction from silver.real_transaction, every deal placed again from its address and lot through the one place-identity resolver (never the Silver's pnu), daily at 09:50, as the 공매 kind's Gold: its Silver loads hourly, and an input-started Gold would wait in the spark pool behind every job within 20 of those hourly cycles; a run whose inputs did not move past the pins the current Gold recorded does nothing. It recomputes only the PNUs of the 법정동s a change reaches (the deals the load appended, both codes of a changed code pair through views.changed_codes, changed parcels, registers, owners and lineage, and the 법정동s whose window lost a month) and merges them; nothing rebuilds it whole. Its own job because an own-producer kind is never a table of `kinds` (root ADR-0287 §9). by_pnu_parcel_real_transaction_bake bakes its commit.",
      "systemd_service": "foundation-gold-lane-rebuild@parcel-real-transaction.service",
      "systemd_timer": null,
      "state_paths": [],
      "schedule": "50 9 * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 150,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": null,
        "first_run": {
          "estimate_seconds": 3600,
          "estimated_from": "computed, never run: the build places every deal from its address and lot on each run (root ADR-0351 §3), 13,476,265 Silver deals on 2026-11-10 (about 50 million once the 250 months of every dataset are in, root ADR-0371), against the served parcels (39,861,511) and the owner rows its 공장창고 inference windows (about 120 million); the same unit template's parcel-ownership full build over those owner rows measured 1,602 s (2026-11-05, its cut-over's gold step), so about two such passes, 3,600 s, inside the 8,100 s share of the 150-minute limit; a first run past it is stopped by TimeoutStartSec and the auto-promotion's gold step resumes it"
        }
      },
      "pool": "spark",
      "pool_slots": 3,
      "priority_weight": 2,
      "retries": 0,
      "pipeline_graph_edges": [
        "silver-real-transaction-to-gold-parcel-real-transaction",
        "reference-legal-dong-code-change-to-gold-parcel-real-transaction",
        "reference-legal-dong-code-snapshot-to-gold-parcel-real-transaction",
        "silver-land-characteristic-to-gold-parcel-real-transaction",
        "silver-building-register-titles-to-gold-parcel-real-transaction",
        "silver-land-ownership-to-gold-parcel-real-transaction",
        "silver-parcel-lineage-to-gold-parcel-real-transaction",
