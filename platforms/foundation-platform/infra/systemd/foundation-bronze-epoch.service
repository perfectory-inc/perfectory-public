[Unit]
Description=Foundation Platform Bronze epoch: run-stamped and renamed-source Bronze objects to today's keys, their ledger rows in place, old keys deleted as the lock lets them go (root ADR-0626 §8 N2)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/bronze-epoch.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# The ledger (the admin password the collectors build DATABASE_URL from) and the lakehouse writer key
# the copies, the evidence and the deletes use.
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/bronze-epoch.sh
# The job list's time_limit_minutes (jobs.v1.json). Generated from the list, not hand-set: `cargo run -p
# foundation-jobs -- generate` (committed_units test).
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824

[Install]
WantedBy=multi-user.target
