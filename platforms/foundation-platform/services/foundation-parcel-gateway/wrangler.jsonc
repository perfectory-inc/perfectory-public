{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundation-parcel-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-26",
  "workers_dev": false,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
      "bucket_name": "foundation-platform-lakehouse-prod"
    }
  ]
}
