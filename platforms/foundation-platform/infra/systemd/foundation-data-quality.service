[Unit]
Description=Foundation Platform data quality: run the data contracts' executable checks and report them to the data catalog (ADR-0117 §6, ADR-0123)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
ExecStart=/opt/foundation-platform/current/scripts/ops/data-quality-check.py
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
