[Unit]
Description=Foundation Platform legal-dong code changes from code.go.kr, the collection half: land the responses in Bronze, validate them, stage a pending-load handoff when they changed (ADR-0143)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/legal-dong-code-changes.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/legal-dong-code-collect.sh
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/legal-dong-code
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
