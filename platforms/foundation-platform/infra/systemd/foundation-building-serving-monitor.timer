[Unit]
Description=Read the live building hostname every hour (root ADR-0151)

[Timer]
# A host check, not a data job: like the database backup it stays a systemd timer (root ADR-0118
# §1). The release installs it; it is enabled after the cut-over (runbook §5).
OnCalendar=*-*-* *:17:00
Persistent=true
RandomizedDelaySec=2m
Unit=foundation-building-serving-monitor.service

[Install]
WantedBy=timers.target
