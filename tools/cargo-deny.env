# Pinned cargo-deny release every CI supply-chain job installs (root ADR-0155).
# `cargo xtask ci install-cargo-deny` installs it; scripts/ci/fetch_pinned.py downloads it and checks the archive's
# SHA-256 before extracting it. A prebuilt binary replaces `cargo install`, which
# compiled cargo-deny from crates.io in every run and is the step that failed on
# 2026-10-06 with the HTTP/2 framing error.
CARGO_DENY_VERSION=0.21.0
CARGO_DENY_LINUX_AMD64_SHA256=a2170b854ff697e79e39c4c538981c9c1bdd803addbae6719a4cb66b4585a903
