[Unit]
Description=GET the live by-PNU hostnames and the parcel edge's media every 15 minutes (root ADR-0327)

[Timer]
# A host check, not a data job: like the serving monitor it stays a systemd timer (root ADR-0118 §1).
# Off the monitor's :17 and the service checks' :41.
OnCalendar=*-*-* *:07/15:00
Persistent=true
RandomizedDelaySec=1m
Unit=foundation-by-pnu-edge-probe.service

[Install]
WantedBy=timers.target
