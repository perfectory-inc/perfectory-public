[Unit]
Description=Start an operator's run-now request, approved cut-over or stop when foundation-api writes one (root ADR-0282 §4, §5, ADR-0433)

[Path]
# foundation-api writes a request whole (a temporary file, then a rename into the directory).
PathChanged=/var/lib/foundation-jobs/switches/run-now.d
# An approved by-PNU cut-over (root ADR-0433 §3), written the same way.
PathChanged=/var/lib/foundation-jobs/switches/cutover.d
# A stop is <job>.stop in the switch directory itself.
PathChanged=/var/lib/foundation-jobs/switches
Unit=foundation-run-now.service

[Install]
WantedBy=paths.target
