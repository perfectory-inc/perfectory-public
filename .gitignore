# Root ignores (belt-and-suspenders over each area's own .gitignore).
# Rust build output — anywhere in the monorepo, including tools/xtask.
target/

# Node / frontend
node_modules/
.pnpm-store/

# Python bytecode
__pycache__/
*.py[cod]

# Local env & secrets (never commit; secret-scan + these lines are the guard)
.env
.env.local
.env.*.local
# Timestamped backups of the above. A rotation left
# `.env.local.bak-20260806T004029Z` tracked-visible in a repository whose remote
# is public: the exact name is ignored while every copy of it was not. Prefix
# match, not a longer list of suffixes, because the next backup will be named by
# whatever tool makes it.
.env.local.*
.env.*.local.*

# OS / editor cruft
.DS_Store
Thumbs.db

# Internal agent plans/specs stay local; maintained decisions belong in docs/adr or runbooks.
docs/superpowers/

# Generated from platforms/foundation-platform/definitions (root ADR-0418): never committed.
/platforms/foundation-platform/orchestration/jobs.v1.json
/platforms/foundation-platform/docs/catalog/pipeline-graph.v1.json
/platforms/foundation-platform/config/r2-connections.contract.json
/tools/host-memory-budget.contract.json
/platforms/foundation-platform/contracts/schema-registry/registry.json
/platforms/foundation-platform/docs/catalog/pipeline-graph.v1.example.json
/platforms/foundation-platform/orchestration/job-dependencies.v1.json
/docs/data-pipeline-map.md
/platforms/foundation-platform/config/by-pnu-lane-index.v1.json
