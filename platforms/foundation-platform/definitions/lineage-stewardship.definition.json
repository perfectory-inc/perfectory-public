  "jobs": [
    {
      "id": "lineage_stewardship",
      "scope": "skip-if-unchanged",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "Parcel lineage stewardship cycle: fold steward decisions, rebuild and load the review queue (root ADR-0115) only when the queue's inputs changed since the last load (scripts/ops/lineage-queue-check.py; otherwise no Spark and no load: gold.lineage_review_queue's 857 rows were last written 2026-10-20). First it loads any pending 필지고유번호변동연혁 handoff into silver.parcel_number_change_history (root ADR-0144 §4), then loads and pairs any pending legal-dong code handoff (root ADR-0143), reading the official links of the pairing window once that table holds rows: the snapshot into reference.legal_dong_code_snapshot, the changes into reference.legal_dong_code_change (the one record of region code changes, root ADR-0145), and the crosswalk projection the hub exports read, a view of that table; a failure there fails the run before lineage starts. Then it derives silver.parcel_lineage (root ADR-0113 §1): for each consecutive pair of the parcel editions the source contract holds, once per sido group (parcel_lineage_scheduled.py), skipping groups already held and starting none after FOUNDATION_LINEAGE_DERIVE_DEADLINE_MINUTES (60), so a backlog spreads over the next runs. After the legal-dong step, when it recorded new pairs (or no follow has run yet), the industrial complexes under the codes of the pairs that changed since the last follow (legal_dong_code_change_views.changed_codes) get their 시도·시군구 codes and 시도 name re-placed in gold.complex_catalog (industrial_complex_silver_to_gold.py --follow-region-codes, a MERGE of only the complexes whose carried codes differ) and the canonical load writes the rows that changed into catalog.industrial_complex (root ADR-0426); a failure there fails the unit at the end without stopping lineage.",
      "systemd_service": "foundation-lineage-stewardship.service",
      "systemd_timer": "foundation-lineage-stewardship.timer",
      "state_paths": [
        "/var/lib/foundation-platform/lineage-stewardship",
        "/var/lib/foundation-platform/legal-dong-code",
        "/var/lib/foundation-platform/parcel-number-change"
      ],
      "schedule": "50 6 * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 10,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 120,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": {
