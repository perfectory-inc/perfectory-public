{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation-platform.parcel_forest_ledger_by_pnu",
  "description": "A forest parcel's newest official ledger facts (임야대장, root ADR-0088): the provider's category, area, ownership category and co-owner count; no owner is named.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "foundation-platform.parcel_forest_ledger_by_pnu.v1",
        "foundation-platform.parcel_forest_ledger_by_pnu.v2"
      ]
    },
    "pnu": {
      "type": "string",
      "pattern": "^[0-9]{19}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string"
        },
        "iceberg_snapshot_id": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "iceberg_snapshot_id"
      ]
    },
    "forest_ledger": {
      "type": "object",
      "properties": {
        "land_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "area_m2": {
          "type": [
            "number",
            "null"
          ]
        },
        "ownership_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownership_kind_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "co_owner_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": []
    },
    "attached_via": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "pnu",
    "source",
    "forest_ledger"
  ]
}
