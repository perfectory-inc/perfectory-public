[Unit]
Description=Foundation Platform 차세대 온비드 public sale, the Silver half: load each pending handoff into silver.onbid_real_estate_item and silver.onbid_item_bid_result (root ADR-0280)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
ExecStart=/opt/foundation-platform/current/scripts/ops/onbid-silver-load.sh
TimeoutStartSec=40m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/onbid

[Install]
WantedBy=multi-user.target
