# sccache, the shared Rust compiler cache CI reads from R2 (root ADR-0294). fetch_pinned.py is the
# only downloader; the version and SHA-256 live here so the pin has one home (root ADR-0197).
# Bump: set the version, then put the published .tar.gz.sha256 of the x86_64-unknown-linux-musl asset
# below (github.com/mozilla/sccache/releases). CI runs on Linux only, so no other platform is pinned.
SCCACHE_VERSION=0.18.0
SCCACHE_LINUX_X86_64_SHA256=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89
