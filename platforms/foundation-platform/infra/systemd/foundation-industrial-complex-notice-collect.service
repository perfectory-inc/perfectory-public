[Unit]
Description=Foundation Platform 산업입지정보시스템 산업단지 고시와 첨부, the collection half: ask the notices not settled, store every attachment once in the shared media store, land the details in Bronze (root ADR-0484)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/industrial-complex-notice.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-complex-notice-collect.sh
# The job list's time_limit_minutes (jobs.v1.json): the notice budget (1,800 s) and one notice.
TimeoutStartSec=40m
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-complex-notice
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
