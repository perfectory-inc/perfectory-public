[Unit]
Description=Foundation Platform 법원경매정보, the Silver half: give each row a PNU by address and load silver.court_auction_item and silver.court_auction_sale_result (root ADR-0280)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
ExecStart=/opt/foundation-platform/current/scripts/ops/court-auction-silver-load.sh
TimeoutStartSec=90m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/court-auction

[Install]
WantedBy=multi-user.target
