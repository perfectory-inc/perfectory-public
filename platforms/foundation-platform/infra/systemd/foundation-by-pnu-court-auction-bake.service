[Unit]
Description=Foundation Platform by-PNU court-auction bake: gold.parcel_court_auction to R2 by-PNU serving section packs, its own job so it bakes beside the panel bake (ADR-0287, ADR-0303)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# The same files the by-PNU serving bake reads: admitted-writer runtime settings, the lakehouse R2
# settings, and the Gold read and served-snapshot tag (catalog and R2 lakehouse writer). The
# optional last file holds only non-secret tuning (FOUNDATION_BY_PNU_BAKE_MAX_CONCURRENCY).
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=-/etc/foundation-platform/by-pnu-bake.env
# The single own-producer court-auction lane, baked alone like the public-auction lane: `all`
# skips an own-producer lane (root ADR-0303).
ExecStart=/opt/foundation-platform/current/scripts/ops/by-pnu-serving-bake.sh parcel-court-auction
# The job list's time_limit_minutes (jobs.v1.json). Generated from the list, not hand-set:
# `cargo run -p foundation-jobs -- generate` (committed_units test).
TimeoutStartSec=115m
# A tiny lane's export, like the public-auction lane's: gold.parcel_court_auction holds the items in
# progress, small JSON. 3G, not the public-auction bake's 5G: the spark pool's worst one-slot set is
# now the three bakes together (14 + 5 + 3 = 22g), which stays at the 22g release builder, so the
# host total does not grow (root ADR-0138, ADR-0303). To be tightened or raised from the first
# production run's measured peak, once court collection is on. The change set runs before the
# export in the compose `spark-small` container (2560m), a Docker cgroup the host budget counts
# beside this unit.
# scripts/guard/every-container-has-a-memory-cap.sh reads this line; without it the guard fails.
MemoryMax=3G
MemorySwapMax=0
# As the sibling serving bake: a process killed at MemoryMax fails the script's step, and the script
# still ends with its `foundation-job-outcome failed ...` line instead of systemd stopping it first.
OOMPolicy=continue
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Work files only on the data disk, never the root disk.
ReadWritePaths=/data/foundation-platform/by-pnu-bake
