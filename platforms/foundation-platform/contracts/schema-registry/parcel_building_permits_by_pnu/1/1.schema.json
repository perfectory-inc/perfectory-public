{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation-platform.parcel_building_permits_by_pnu",
  "description": "A parcel's 건축인허가 기본개요 as 건축HUB lists them (root ADR-0356, ADR-0451): the current permit rows (one per 관리허가대장PK) on the parcel, newest first by the latest of its dates, each in the provider's words, at most 50; building_permit_total counts them all.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "foundation-platform.parcel_building_permits_by_pnu.v1"
      ]
    },
    "schema_revision": {
      "type": "integer"
    },
    "pnu": {
      "type": "string",
      "pattern": "^[0-9]{19}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string"
        },
        "iceberg_snapshot_id": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "iceberg_snapshot_id"
      ]
    },
    "building_permits": {
      "type": "object",
      "properties": {
        "records": {
          "description": "The parcel's permits newest first, at most 50.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "arch_kind_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "main_purpose_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plot_area_m2": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "building_area_m2": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "total_floor_area_m2": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permit_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_scheduled_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_delayed_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_actual_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "use_approval_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "required": [
        "records"
      ]
    },
    "building_permit_total": {
      "type": [
        "integer",
        "null"
      ]
    },
    "attached_via": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "pnu",
    "source",
    "building_permits"
  ]
}
