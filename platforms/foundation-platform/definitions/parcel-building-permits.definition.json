    {
      "id": "gold_parcel_building_permits_rebuild",
      "scope": "changed-keys",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "건축인허가 kind Gold (root ADR-0451; scripts/ops/gold-panel-rebuild.sh parcel-building-permits): gold.parcel_building_permits from the current rows of silver.building_permit_basis_outline (건축인허가 기본개요) and, by the same 관리허가대장PK, silver.building_permit_parking (root ADR-0452), and one list per other file of the permit family (동별개요, 층별개요, 대지위치, 대수선, 가설건축물, 부설주차장, 공작물관리대장 by their own PNU, and 정기점검이력 through the 표제부 its 관리건축물대장PK names, root ADR-0404 §2, ADR-0464), when the Silver lane or the served parcel edition moved past the pins the current Gold recorded. It recomputes only the PNUs whose current permit rows differ between the pinned and the current Silver (both directions, so a permit that moved PNU leaves its old parcel) of the permits whose parking rows changed (before and after), whose rows of another file of the family changed (before and after; a changed 표제부 counts as a change of the inspections it links), and of parcels that entered or left the served edition, and merges them; a change of the code change table rebuilds whole (building_permit_silver_to_gold.WHOLE_TABLE_INPUTS). Its own job because an own-producer kind is never a table of `kinds` (root ADR-0287 §9). by_pnu_parcel_building_permits_bake bakes its commit.",
      "systemd_service": "foundation-gold-lane-rebuild@parcel-building-permits.service",
      "systemd_timer": null,
      "state_paths": [],
      "schedule": "15 10 * * *",
      "started_by": "inputs",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 150,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": null,
        "first_run": {
          "estimate_seconds": 1800,
          "estimated_from": "computed from the lane's own full build measured in its cut-over's gold step (the operator's copy of this unit, gold-panel-rebuild.sh parcel-building-permits): 203 s on 2026-11-09 for 6,527,521 permits from the three permit Silver tables then loaded (gold.parcel_building_permits 3,416,149 rows, committed 03:01:40Z), and 27-39 s for its no-change runs; root ADR-0464 adds eight more files of the same family, each its own list, so the first build with them reads about four times the rows: 4 x 203 s plus the Spark start, rounded up to 1,800 s"
        }
      },
      "pool": "spark",
      "pool_slots": 3,
      "priority_weight": 2,
      "retries": 0,
