[Unit]
Description=Fail when an identity database backup is older than a day
Documentation=file:///opt/foundation-platform/current/docs/runbooks/foundation-platform-low-cost-production-hardening.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service
# Stale backups fail every check until one lands: one alert, resolved by the first fresh check.
OnSuccess=foundation-unit-recovered@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
ExecStart=/opt/foundation-platform/current/scripts/recovery/check-identity-backup-freshness.sh
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
