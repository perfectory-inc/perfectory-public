[Unit]
Description=Foundation Platform by-PNU serving bake: Gold panels to R2 by-PNU serving, objects or section packs (ADR-0122, ADR-0138, ADR-0147)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# The same files the FLOOR cycle reads: the lakehouse catalog and the R2 lakehouse writer. The
# optional last file holds only non-secret tuning (FOUNDATION_BY_PNU_BAKE_MAX_CONCURRENCY).
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=-/etc/foundation-platform/by-pnu-bake.env
# The building lane alone until the parcel lane serves section packs (root ADR-0147 §8): the parcel
# lane still serves one object per PNU, and reflecting one new Gold snapshot there could rewrite up
# to 39.86M objects that the pack cut-over replaces anyway. `all` (parcel, then building, one after
# the other: side by side they would not fit the host memory budget, root ADR-0138) comes back with
# that cut-over.
ExecStart=/opt/foundation-platform/current/scripts/ops/by-pnu-serving-bake.sh building
# A national first bake runs for days of R2 writes; the next start resumes where this one stopped.
TimeoutStartSec=20h
# Measured on ai-server on 2026-10-03 (root ADR-0138): the export of one real parcel shard of
# 898,741 rows peaked at 11,108,622,336 bytes of anonymous memory, about 7.8GB of it the one data
# file the scan decodes whole; 1,970,539 rows peaked at 15,025,704,960. The export refuses a shard
# over 900,000 rows before it holds more, so 14G is that measured peak x1.3. The building lane's
# shards peak lower (6.1GB measured at 867,696 rows). scripts/guard/every-container-has-a-memory-cap.sh
# reads this line; without it the guard fails.
# A patch (root ADR-0141) keeps only its change set's rows under the same row cap, so it needs no
# more. Its change set runs before the export in the compose `spark-small` container (2560m), a
# Docker cgroup outside this unit that the host budget counts beside it; measured 1,508,237,312
# bytes of anonymous memory for the national parcel comparison.
MemoryMax=14G
MemorySwapMax=0
# A lane killed at MemoryMax must not stop the other: by default systemd stops the whole unit when
# one of its processes is OOM-killed. The killed lane still fails the unit, and resumes next run.
OOMPolicy=continue
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Work files only on the data disk, never the root disk.
ReadWritePaths=/data/foundation-platform/by-pnu-bake
