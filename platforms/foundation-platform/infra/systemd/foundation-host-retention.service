[Unit]
Description=Foundation Platform: remove Docker images nothing on the host still needs (root ADR-0198)
Requires=docker.service
After=docker.service
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# ProtectHome hides the service user's ~/.docker and ProtectSystem makes the rest read-only, so the
# Docker CLI gets a config directory it can write inside the unit's private /tmp.
Environment=DOCKER_CONFIG=/tmp/docker-config
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/foundation-platform/current/scripts/ops/host_retention.py --reference-root /opt/perfectory-control/current
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
