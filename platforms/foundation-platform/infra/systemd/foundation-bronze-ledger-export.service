[Unit]
Description=Foundation Platform Bronze ledger export: the host ledger rows of the sources whose lanes moved to AWS with a Lakekeeper table, once each, to control/evidence/ledger_move/ (root ADR-0616 A4)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/lakekeeper.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# The ledger (the admin password the collectors build DATABASE_URL from) and the lakehouse writer key the
# export is written with.
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/bronze-ledger-export.sh
# The job list's time_limit_minutes (jobs.v1.json). Generated from the list, not hand-set: `cargo run -p
# foundation-jobs -- generate` (committed_units test).
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824

[Install]
WantedBy=multi-user.target
