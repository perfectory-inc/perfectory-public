  "handoff_prefix": "silver-handoff/vworldkr__land_use_plan",
  "handoff_prefix_reason": "Where the converted handoff objects live — declared once here so the exporter that writes them and the loader that reads them cannot drift apart (same reason as the parcel contract).",
  "handoff_suffix": ".jsonl.gz",
  "handoff_suffix_reason": "The converter names the object and the loader derives the same name; .gz also tells the converter to compress and Spark to decompress.",
