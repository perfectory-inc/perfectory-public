[Unit]
Description=Run the parcel lineage stewardship cycle once a day (ADR-0115)

[Timer]
# Before the working day in Korea, so stewards start from today's list. The host clock is UTC, so the
# zone is named here instead of converted by hand; minute 50 is one no map edit fold uses.
OnCalendar=*-*-* 07:50:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=5m
Unit=foundation-lineage-stewardship.service

[Install]
WantedBy=timers.target
