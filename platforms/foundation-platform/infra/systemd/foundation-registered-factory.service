[Unit]
Description=Foundation Platform 전국등록공장현황 from data.go.kr: land a new edition in Bronze, give its rows a PNU by address and load silver.registered_factory (root ADR-0280)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/data-go-kr-registered-factory.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/registered-factory-cycle.sh
TimeoutStartSec=90m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/registered-factory
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0454); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
