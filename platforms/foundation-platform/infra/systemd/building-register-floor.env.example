# 비밀 없는 release별 설정. foundation-release.sh floor-config가 이 키 목록을 검사한다.
# 설치 위치는 해당 release의 .foundation-floor.env(root:root 0644)다.
# ROOT는 current 링크가 아닌 /opt/foundation-platform/releases/<40자리 Git SHA> 실제 경로다.
# 비밀번호·토큰은 기존 systemd EnvironmentFile에서만 주입하며 여기에 복사하지 않는다.
FOUNDATION_PLATFORM_REMOTE_LAKEHOUSE_ROOT=
# 운영 증거 원본은 공개 소스 밖의 root 소유 읽기 전용 파일이다. SHA는 실행 부모가 계산한다.
FOUNDATION_PLATFORM_BUILDING_REGISTER_FLOOR_HISTORY_PATH=/etc/foundation-platform-inputs/building-register-floor-history.json
FOUNDATION_PLATFORM_LAKEHOUSE_CONTROL_IMAGE=
# 기존 DB의 Docker network 이름과 그 안에서 사용하는 DNS 이름:내부 port.
# DATABASE_URL의 계정/비밀번호는 재사용한다. 호스트 loopback 주소를 넣지 않는다.
FOUNDATION_PLATFORM_LAKEHOUSE_DATABASE_NETWORK=
FOUNDATION_PLATFORM_LAKEHOUSE_DATABASE_ENDPOINT=
FOUNDATION_PLATFORM_LAKEHOUSE_STATE_ROOT=/data/foundation-platform/building-register-floor
FOUNDATION_PLATFORM_LAKEHOUSE_IVY_CACHE=/data/foundation-platform/building-register-floor/ivy
