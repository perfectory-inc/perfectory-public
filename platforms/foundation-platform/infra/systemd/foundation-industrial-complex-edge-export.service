[Unit]
Description=Foundation Platform industrial-complex edge: write the profiles of the complexes whose Gold row or document facts changed, and the index when it changed (root ADR-0456, ADR-0563)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/intelligence-documents.md
X-Foundation-Owner=lakehouse
After=network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-complex-edge-export.sh
TimeoutStartSec=15m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-complex-edge
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
