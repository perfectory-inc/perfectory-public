        "foundation-platform.parcel_factories_by_pnu.v1"
      ]
    },
    "schema_revision": {
      "type": "integer"
    },
    "pnu": {
      "type": "string",
      "pattern": "^[0-9]{19}$"
    },
    "source": {
      "type": "object",
