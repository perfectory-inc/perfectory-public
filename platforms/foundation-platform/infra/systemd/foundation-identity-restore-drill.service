[Unit]
Description=Restore the identity database backups into throwaway containers and log in to the restored Zitadel
Documentation=file:///opt/foundation-platform/current/docs/runbooks/foundation-platform-low-cost-production-hardening.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service
# A retried unit fails more than once: one alert that its next success resolves (notify-unit-failure.sh).
OnSuccess=foundation-unit-recovered@%n.service
# A failed drill tries again after 6 h, 12 h, then a day, not a week later (root ADR-0445 §5), so a fix that
# deploys meanwhile is proven the same week. 2026-11-08: both drills failed, were fixed by 11:43Z (#1180), and
# would have stayed failed until the 11-15 timer.
StartLimitIntervalSec=6d
StartLimitBurst=6

[Service]
Type=oneshot
Restart=on-failure
RestartSec=6h
RestartSteps=2
RestartMaxDelaySec=1d
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
Environment=FOUNDATION_RECOVERY_EVIDENCE_DIR=/var/lib/foundation-platform/recovery
EnvironmentFile=/etc/foundation-platform/recovery.env
# A live Zitadel token: only a request the restored Zitadel must decrypt proves its masterkey.
LoadCredential=zitadel-token:/etc/identity-platform/secrets/zitadel-bootstrap-pat
ExecStart=/opt/foundation-platform/current/scripts/recovery/identity-restore-drill.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/recovery
