      "properties": {
        "records": {
          "description": "The parcel's distinct factories by 회사명, at most 50.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "company_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "complex_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "products": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "required": [
