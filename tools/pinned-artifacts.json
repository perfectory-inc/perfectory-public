{
  "schema_version": 1,
  "description": "Where each checksum-pinned release binary CI uses is downloaded from. The versions and SHA-256 values stay in the env file each entry names; this file only says how to spell the asset URL for a platform. scripts/ci/fetch_pinned.py is the only reader and the only downloader (root ADR-0197).",
  "tools": {
    "actionlint": {
      "pins": "tools/actionlint.env",
      "version_variable": "ACTIONLINT_VERSION",
      "sha256_variable": "ACTIONLINT_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "amd64", "aarch64": "arm64"},
      "extension": {"linux": "tar.gz", "darwin": "tar.gz", "windows": "zip"},
      "url": "https://github.com/rhysd/actionlint/releases/download/v{version}/actionlint_{version}_{os}_{arch}.{extension}"
    },
    "promtool": {
      "pins": "tools/promtool.env",
      "version_variable": "PROMTOOL_VERSION",
      "sha256_variable": "PROMTOOL_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "amd64", "aarch64": "arm64"},
      "extension": {"linux": "tar.gz", "darwin": "tar.gz", "windows": "tar.gz"},
      "url": "https://github.com/prometheus/prometheus/releases/download/v{version}/prometheus-{version}.{os}-{arch}.{extension}"
    },
    "gitleaks": {
      "pins": "tools/gitleaks.env",
      "version_variable": "GITLEAKS_VERSION",
      "sha256_variable": "GITLEAKS_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "x64", "aarch64": "arm64"},
      "extension": {"linux": "tar.gz", "darwin": "tar.gz", "windows": "zip"},
      "url": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_{os}_{arch}.{extension}"
    },
    "osv-scanner": {
      "pins": "tools/osv-scanner.env",
      "version_variable": "OSV_SCANNER_VERSION",
      "sha256_variable": "OSV_SCANNER_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "amd64", "aarch64": "arm64"},
      "extension": {"linux": "", "darwin": "", "windows": ".exe"},
      "url": "https://github.com/google/osv-scanner/releases/download/v{version}/osv-scanner_{os}_{arch}{extension}"
    },
    "opengrep": {
      "pins": "tools/opengrep.env",
      "version_variable": "OPENGREP_VERSION",
      "sha256_variable": "OPENGREP_{OS}_{ARCH}_SHA256",
      "os": {"linux": "manylinux", "darwin": "osx", "windows": "windows"},
      "arch": {"x86_64": "x86"},
      "extension": {"linux": "", "darwin": "", "windows": ".exe"},
      "url": "https://github.com/opengrep/opengrep/releases/download/v{version}/opengrep_{os}_{arch}{extension}"
    },
    "docker-compose": {
      "pins": "tools/docker-compose.env",
      "version_variable": "DOCKER_COMPOSE_VERSION",
      "sha256_variable": "DOCKER_COMPOSE_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "x86_64", "aarch64": "aarch64"},
      "extension": {"linux": "", "darwin": "", "windows": ".exe"},
      "url": "https://github.com/docker/compose/releases/download/v{version}/docker-compose-{os}-{arch}{extension}"
    },
    "conftest": {
      "pins": "tools/conftest.env",
      "version_variable": "CONFTEST_VERSION",
      "sha256_variable": "CONFTEST_{OS}_{ARCH}_SHA256",
      "os": {"linux": "Linux", "darwin": "Darwin", "windows": "Windows"},
      "arch": {"x86_64": "x86_64", "aarch64": "arm64"},
      "extension": {"linux": "tar.gz", "darwin": "tar.gz", "windows": "zip"},
      "url": "https://github.com/open-policy-agent/conftest/releases/download/v{version}/conftest_{version}_{os}_{arch}.{extension}"
    },
    "cargo-deny": {
      "pins": "tools/cargo-deny.env",
      "version_variable": "CARGO_DENY_VERSION",
      "sha256_variable": "CARGO_DENY_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux"},
      "arch": {"x86_64": "amd64"},
      "extension": {"linux": "tar.gz"},
      "url": "https://github.com/EmbarkStudios/cargo-deny/releases/download/{version}/cargo-deny-{version}-x86_64-unknown-linux-musl.{extension}"
    },
    "sccache": {
      "pins": "tools/sccache.env",
      "version_variable": "SCCACHE_VERSION",
      "sha256_variable": "SCCACHE_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux"},
      "arch": {"x86_64": "x86_64"},
      "target": {"linux": "x86_64-unknown-linux-musl"},
      "extension": {"linux": "tar.gz"},
      "url": "https://github.com/mozilla/sccache/releases/download/v{version}/sccache-v{version}-{target}.{extension}"
    },
    "cargo-nextest": {
      "pins": "tools/cargo-nextest.env",
      "version_variable": "CARGO_NEXTEST_VERSION",
      "sha256_variable": "CARGO_NEXTEST_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "windows": "windows"},
      "arch": {"x86_64": "amd64"},
      "target": {"linux": "x86_64-unknown-linux-gnu", "windows": "x86_64-pc-windows-msvc"},
      "extension": {"linux": "tar.gz", "windows": "zip"},
      "url": "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-{version}/cargo-nextest-{version}-{target}.{extension}"
    },
    "cargo-hakari": {
      "pins": "tools/cargo-hakari.env",
      "version_variable": "CARGO_HAKARI_VERSION",
      "sha256_variable": "CARGO_HAKARI_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "windows": "windows"},
      "arch": {"x86_64": "amd64"},
      "target": {"linux": "x86_64-unknown-linux-gnu", "windows": "x86_64-pc-windows-msvc"},
      "extension": {"linux": "tar.gz", "windows": "zip"},
      "url": "https://github.com/guppy-rs/guppy/releases/download/cargo-hakari-{version}/cargo-hakari-{version}-{target}.{extension}"
    },
    "zizmor": {
      "pins": "tools/zizmor.env",
      "version_variable": "ZIZMOR_VERSION",
      "sha256_variable": "ZIZMOR_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux", "darwin": "darwin", "windows": "windows"},
      "arch": {"x86_64": "x86_64"},
      "target": {"linux": "unknown-linux-gnu", "darwin": "apple-darwin", "windows": "pc-windows-msvc"},
      "extension": {"linux": "tar.gz", "darwin": "tar.gz", "windows": "zip"},
      "url": "https://github.com/zizmorcore/zizmor/releases/download/v{version}/zizmor-{arch}-{target}.{extension}"
    },
    "syft": {
      "pins": "tools/syft.env",
      "version_variable": "SYFT_VERSION",
      "sha256_variable": "SYFT_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux"},
      "arch": {"x86_64": "amd64"},
      "extension": {"linux": "tar.gz"},
      "url": "https://github.com/anchore/syft/releases/download/v{version}/syft_{version}_{os}_{arch}.{extension}"
    },
    "cosign": {
      "ci": false,
      "pins": "tools/cosign.env",
      "version_variable": "COSIGN_VERSION",
      "sha256_variable": "COSIGN_{OS}_{ARCH}_SHA256",
      "os": {"linux": "linux"},
      "arch": {"x86_64": "amd64", "aarch64": "arm64"},
      "extension": {"linux": ""},
      "url": "https://github.com/sigstore/cosign/releases/download/v{version}/cosign-{os}-{arch}"
    }
  },
  "contracts": [
    "platforms/foundation-platform/config/static-release-toolchain.contract.json",
    "platforms/foundation-platform/infra/lakehouse/contracts/duckdb-extensions.contract.json"
  ]
}
