  "group": "onbid-public-auction-collect",
  "jobs": [
    {
      "id": "onbid_public_auction_collect",
      "scope": "full",
      "full_reason": "Every three hours it reads the whole open-item list: a condition that left the list is known only from a complete pass (root ADR-0275).",
      "full_cost": "measured: a complete item-list pass is about 8.8 MB gzipped into Bronze (data-go-kr-onbid.contract.json item_list), every 3 hours, about 70 MB a day; 2026-10-29 it listed 50,192 open conditions (onbid-item-detail.prom), at page_size 1,000 over 20 (prptDivCd, pvctTrgtYn) combinations at most about 70 list calls a pass (computed). The rest of each run is new-objects: details, bid info and announcement details only for conditions owed one (root ADR-0330, ADR-0339).",
      "full_tracked_by": "justified permanently by root ADR-0275: the provider has no changed-since query, and a condition that left the list is known only from a complete pass; its Silver load appends only changed rows",
      "interruptible": false,
      "commits": "at_end",
      "description": "차세대 온비드 public sale from data.go.kr (root ADR-0280), the collection half: every hour, the announcement and announcement bid-result lists for their opening windows, the full open-item list when three hours have passed since the last complete pass, and the bid result of each item condition that left the list, each API within its own daily call limit (data-go-kr-onbid.contract.json). The 물건상세 of each open condition owed one (never complete, or its list row's mdfcnDt changed), open rounds and the earliest bid end first, with its photos and appraisals mirrored to the content-addressed media store; a condition is complete only once its media all landed, and the coverage is written to /var/lib/foundation-jobs/metrics for the FoundationOnbidDetailCoverage* alerts (root ADR-0330). Lands one gzip JSON Lines Bronze object per API per run; hands nothing on (onbid_public_auction_silver finds what it owes in R2). Since root ADR-0340 also, per open item, its 물건상세 입찰정보 (per_run_limit 300), and per announcement the list held, its 공고상세 with its attachments mirrored (per_run_limit 200), each within its own daily call limit and isolated on failure. No Spark.",
      "systemd_service": "foundation-onbid-collect.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/onbid",
        "/var/lib/foundation-jobs/metrics"
      ],
      "schedule": "7 * * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 40,
      "per_run_cap": {
        "unit": "request",
        "limits": [
          "infra/lakehouse/contracts/data-go-kr-onbid.contract.json#/item_bid_result/per_run_limit",
          "infra/lakehouse/contracts/data-go-kr-onbid.contract.json#/item_detail/per_run_limit",
          "infra/lakehouse/contracts/data-go-kr-onbid.contract.json#/item_bid_info/per_run_limit",
          "infra/lakehouse/contracts/data-go-kr-onbid.contract.json#/announcement_detail/per_run_limit",
          "infra/lakehouse/contracts/data-go-kr-onbid.contract.json#/media/per_run_limit"
        ],
        "deadline": null,
        "measured_run_seconds": {
          "runs": 183,
          "p50": 381,
          "p90": 1168,
          "max": 1725,
          "timeouts": 0,
          "from": "2026-10-27T01:22:05Z",
          "to": "2026-11-03T15:50:32Z",
          "from_change": "#871 merged 2026-10-27T01:16:28Z, the last of the per-run caps after the 2026-10-26 timeouts (#862, #864)"
        }
      },
      "pool": "default_pool",
      "pipeline_graph_edges": [
        "source-data-go-kr-onbid-to-silver-onbid-real-estate-item",
        "source-data-go-kr-onbid-to-silver-onbid-item-bid-result",
        "source-data-go-kr-onbid-to-silver-onbid-real-estate-item-photo",
        "source-data-go-kr-onbid-to-silver-onbid-announcement",
        "source-data-go-kr-onbid-to-silver-onbid-announcement-bid-result",
        "source-data-go-kr-onbid-to-silver-onbid-announcement-detail",
        "source-data-go-kr-onbid-to-silver-onbid-real-estate-item-detail",
        "source-data-go-kr-onbid-to-silver-onbid-item-bid-info"
      ],
      "enabled": true,
      "enabled_since": "2026-10-20T01:26:10Z",
      "dagster_stage": "shadow",
      "expected_outcome": {
        "changes_within_hours": 6,
        "basis": "onbid lists change continuously (expected_cadence continuous, 6..24 h); measured 2026-11-11 from each unit's journal, 10-12..11-11 (read-only): changed in all 437 runs. Six hourly runs that wrote nothing are a collector that stopped collecting."
      }
    }
