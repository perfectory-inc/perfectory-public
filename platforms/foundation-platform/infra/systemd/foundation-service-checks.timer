[Unit]
Description=Run the service checks every hour (root ADR-0209)

[Timer]
# A host check, not a data job: like the serving monitor it stays a systemd timer (root ADR-0118 §1).
OnCalendar=*-*-* *:41:00
Persistent=true
RandomizedDelaySec=2m
Unit=foundation-service-checks.service

[Install]
WantedBy=timers.target
