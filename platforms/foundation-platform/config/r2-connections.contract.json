{
  "schema_version": 2,
  "provider": "cloudflare-r2",
  "environment": "production",
  "purpose": "Non-secret R2 connection metadata and environment-key contract for Foundation Platform.",
  "profile_gateway": {
    "worker_name": "foundation-profile-gateway",
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "gold/industrial-complex/profiles",
      "artifact_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
      "suffix": ".json"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=31536000, immutable"
  },
  "parcel_by_pnu_gateway": {
    "worker_name": "foundation-parcel-gateway",
    "public_hostname": "catalog.perfectory.io",
    "public_hostname_aliases": [
      "catalog.gongzzang.app"
    ],
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "serving/parcels/by-pnu",
      "generation_dir_pattern": "v[1-9][0-9]{0,17}",
      "patch_dir_pattern": "p[1-9][0-9]{0,17}",
      "pnu_pattern": "[0-9]{10}[1289][0-9]{8}",
      "suffix": ".json",
      "manifest_object": "serving/parcels/by-pnu/manifest.json",
      "manifest_history_dir": "serving/parcels/by-pnu/manifest-history"
    },
    "request_path": {
      "prefix": "/parcels/by-pnu/",
      "capabilities": "/parcels/by-pnu/_capabilities"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=3600",
    "manifest_cache_control": "no-cache, max-age=0",
    "manifest_edge_cache_seconds": 60
  },
  "connections": {
    "lakehouse": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_ACCOUNT_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_ENDPOINT",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_BUCKET",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_REGION",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_READER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_PARCEL_PUBLICATION_EVIDENCE_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_PARCEL_PUBLICATION_EVIDENCE_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_BUCKET": "foundation-platform-lakehouse-prod",
        "FOUNDATION_PLATFORM_R2_LAKEHOUSE_REGION": "auto"
      }
    },
    "tile_derivatives": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_ACCOUNT_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_ENDPOINT",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_BUCKET",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_REGION",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_READER_SECRET_ACCESS_KEY"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_BUCKET": "foundation-platform-tile-derivatives-prod",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_REGION": "auto",
        "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX": "gold/vector-tiles/releases"
      }
    },
    "postgres_recovery": {
      "required_env": [
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_BUCKET",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_ENDPOINT_HOST",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_WRITER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_WRITER_SECRET_ACCESS_KEY",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_READER_ACCESS_KEY_ID",
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_READER_SECRET_ACCESS_KEY"
      ],
      "expected_values": {
        "FOUNDATION_PLATFORM_R2_POSTGRES_RECOVERY_BUCKET": "foundation-platform-postgres-recovery-prod"
      }
    }
  },
  "by_pnu_serving_patches": {
    "decision": "docs/adr/0141-by-pnu-serving-publishes-changed-documents-as-patch-generations.md",
    "manifest_schema_version": 2,
    "max_patches": 7,
    "max_cumulative_change_ratio": 0.05,
    "max_delta_fraction": 0.5,
    "pnu_prefix_length": 5,
    "tombstone_schema_version": "foundation-platform.by_pnu_serving_tombstone.v1",
    "tombstone_max_bytes": 512
  },
  "building_by_pnu_gateway": {
    "worker_name": "foundation-building-gateway",
    "public_hostname": "buildings.perfectory.io",
    "public_hostname_aliases": [
      "buildings.gongzzang.app"
    ],
    "connection": "lakehouse",
    "r2_binding": "FOUNDATION_PLATFORM_LAKEHOUSE",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "public_base_url_env": "FOUNDATION_PLATFORM_R2_LAKEHOUSE_PUBLIC_BASE_URL",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": "serving/buildings/by-pnu",
      "generation_dir_pattern": "v[1-9][0-9]{0,17}",
      "patch_dir_pattern": "p[1-9][0-9]{0,17}",
      "pnu_pattern": "[0-9]{10}[1289][0-9]{8}",
      "suffix": ".json",
      "manifest_object": "serving/buildings/by-pnu/manifest.json",
      "manifest_history_dir": "serving/buildings/by-pnu/manifest-history"
    },
    "request_path": {
      "prefix": "/buildings/by-pnu/",
      "capabilities": "/buildings/by-pnu/_capabilities"
    },
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    },
    "content_type": "application/json; charset=utf-8",
    "cache_control": "public, max-age=3600",
    "manifest_cache_control": "no-cache, max-age=0",
    "manifest_edge_cache_seconds": 60
  },
  "vector_tile_gateway": {
    "worker_name": "foundation-tile-gateway",
    "public_hostname": "tiles.perfectory.io",
    "public_hostname_aliases": [
      "tiles.gongzzang.app"
    ],
    "connection": "tile_derivatives",
    "r2_binding": "FOUNDATION_PLATFORM_TILE_DERIVATIVES",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "compatibility_date": "2026-04-26",
    "object_key": {
      "root": {
        "expected_value": "FOUNDATION_PLATFORM_R2_TILE_DERIVATIVES_PREFIX"
      },
      "source_id_pattern": "[a-z][a-z0-9_]{0,63}-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
      "suffix": ".pmtiles"
    },
    "max_zoom": 24,
    "content_type": "application/vnd.mapbox-vector-tile",
    "cache_control": "public, max-age=31536000, immutable",
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    }
  },
  "map_edit_gateway": {
    "worker_name": "foundation-map-edit-gateway",
    "public_hostname": "map-edits.perfectory.io",
    "public_hostname_aliases": [],
    "d1_binding": "FOUNDATION_PLATFORM_MAP_EDITS",
    "d1_database_name": "foundation-map-edits",
    "allowed_origins_binding": "FOUNDATION_PLATFORM_CORS_ALLOWED_ORIGINS",
    "write_token_binding": "FOUNDATION_PLATFORM_MAP_EDIT_WRITE_TOKEN",
    "compatibility_date": "2026-04-26",
    "units": {
      "complex": {
        "feature_id_property": "complex_id",
        "feature_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        "properties": {
          "official_complex_code": "string"
        }
      },
      "admin": {
        "feature_id_property": "administrative_unit_id",
        "feature_id_pattern": "[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        "properties": {
          "scope_kind": "string",
          "canonical_code": "string",
          "display_name": "string"
        }
      }
    },
    "geometry": {
      "types": [
        "Polygon",
        "MultiPolygon"
      ],
      "bounds_wgs84": [124.0, 32.9, 132.0, 38.9], "bounds_wgs84_review": "public-repository-safety: reviewed-runtime-coordinate — the national extent an edit must fall inside, not a place",
      "max_vertices": 20000,
      "max_body_bytes": 1048576
    },
    "max_pending_edits_per_unit": 5000,
    "overlay_cache_control": "public, max-age=0, must-revalidate",
    "content_type": "application/json; charset=utf-8",
    "cors": {
      "grammar": "comma-separated-serialized-http-origins-v1",
      "allow_wildcard": false,
      "accepted": [
        "https://app.example.test",
        " http://localhost:3000 , https://app.example.test "
      ],
      "rejected": [
        "*",
        "file:///tmp/app",
        "https://app.example.test/path"
      ]
    }
  }
}
