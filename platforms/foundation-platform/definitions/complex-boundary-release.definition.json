    {
      "id": "complex_boundary_release",
      "scope": "skip-if-unchanged",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "Load the newest industrial-complex boundary file into Silver and fold it into the complex tiles (root ADR-0240; scripts/ops/complex-boundary-release.sh): take the boundary ZIP the daily sweep landed last, turn its shapefile into Silver rows (export-industrial-complex-boundary-silver-handoff) and append them beside the earlier version unless the table's ingest record already holds that ZIP (`unchanged`); the readers take the newest version. When it changed, rebake the complex tiles with the hourly fold's own script. Started when a source_sweep run lands new files, and daily as the fallback; it holds every spark slot, so it never runs beside a fold.",
      "systemd_service": "foundation-complex-boundary-release.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/map-edit-fold"
      ],
