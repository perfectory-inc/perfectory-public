[Unit]
Description=Foundation Platform audit digest: check the audit chain's new rows, witness their digest in the public Rekor log and keep it (root ADR-0569 §4)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/audit-log.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
RuntimeDirectory=foundation-audit-digest
RuntimeDirectoryMode=0750
ExecStart=/opt/foundation-platform/current/scripts/ops/audit-digest.sh prepare
# Root (+) and from the control checkout, like the shape ledger's writer key: the witness key is
# root's alone (/var/lib/perfectory/audit-witness, 0600) and the pinned cosign is root's cache.
ExecStart=+/opt/perfectory-control/current/platforms/foundation-platform/scripts/ops/audit-witness.sh
ExecStart=/opt/foundation-platform/current/scripts/ops/audit-digest.sh record
# A oneshot run is capped by its start timeout; systemd ignores RuntimeMaxSec= on Type=oneshot.
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
