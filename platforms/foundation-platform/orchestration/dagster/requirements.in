# The Dagster code location's direct dependencies (root ADR-0333 stage 0). requirements.txt is the
# lock with hashes, compiled from this file only:
#   uv pip compile requirements.in --generate-hashes --python-version 3.14 --python-platform x86_64-manylinux_2_28 -o requirements.txt
# Dagster's packages move in lockstep: dagster X.Y.Z with its integrations at 0.(Y+16).Z.
dagster==1.13.27
dagster-webserver==1.13.27
dagster-postgres==0.29.27
dagster-airlift[core]==0.29.27
# A proxied job's run reaches the host's forced command with the SSH client Airflow's SSH provider uses
# (apache-airflow-providers-ssh 6.0.1 on apache/airflow 3.3.2 holds paramiko 5.0.0), run_jobs.py.
paramiko==5.0.0
# A run Dagster decides tells the data catalog of itself as Airflow's OpenLineage provider did, with the
# client that provider holds on apache/airflow 3.3.2 (root ADR-0565 §7, lineage.py).
openlineage-python==1.53.0
# The unit-price checks read the lakehouse through Trino's own client.
trino==0.340.0
# The code location reads the data contracts' YAML for their checks (contract_checks.py, root ADR-0609 §2).
pyyaml==6.0.3
# SQLAlchemy 2.1 made psycopg (3) the driver of a bare postgresql:// URL, which dagster-postgres
# builds while installing psycopg2: on 2.1 the instance did not start (ModuleNotFoundError psycopg,
# 2026-10-29). Lift this when dagster-postgres names its driver.
sqlalchemy<2.1
