{
  "$schema": "scripts/catalog/definition.v1.schema.json",
  "definition": "foundation-platform.definition.v1",
  "group": "parcel-registry",
  "jobs": [
    {
      "id": "parcel_registry",
      "scope": "changed-keys",
      "interruptible": false,
      "commits": "at_end",
      "description": "Register the served cadastral edition's regions in silver.parcel_registry (root ADR-0243; scripts/ops/parcel-registry-cycle.sh): ask which sido prefixes of the edition the registry holds nothing for, smallest first, and bootstrap them one region at a time, starting no new region after 100 minutes so the run ends inside the unit's limit; the next run takes the rest (`unchanged` once every region is registered). Carrying ids across a new edition (advance) reads silver.parcel_lineage, which lineage_stewardship derives, and is a separate change. Daily; it holds every spark slot (the largest region needs the 20g Spark).",
      "systemd_service": "foundation-parcel-registry.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/lineage-stewardship"
      ],
      "schedule": "10 10 * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 10,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 150,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": {
          "runs": 2,
          "p50": 1,
          "p90": 1429,
          "max": 1429,
          "timeouts": 0,
          "from": "2026-10-16T03:55:46Z",
          "to": "2026-11-03T15:50:32Z"
        }
      },
      "pool": "spark",
      "pool_slots": 3,
      "priority_weight": 1,
      "retries": 0,
      "pipeline_graph_edges": [
        "silver-parcel-boundaries-to-silver-parcel-registry"
      ],
      "enabled": true,
      "enabled_since": "2026-11-09T03:00:00Z",
      "dagster_stage": "shadow",
      "expected_outcome": {
        "changes_within_hours": null,
        "no_change_bound_reason": "Changes only when its inputs moved. That it is not behind them is the asset reconciler's lag (root ADR-0333) and its lane's behind-inputs bound (root ADR-0444); a change bound here would report a source that published nothing."
      }
    }
  ],
  "assets": [
    {
      "id": "silver-parcel-registry",
      "type": "silver_table",
      "title": "필지 ID 원장",
      "description": "필지마다 바뀌지 않는 parcel_id 가 언제부터 언제까지 어떤 PNU 였는지를 쌓는다. 합병·분할은 새 ID, 번호만 바뀌면 같은 ID(루트 ADR-0113).",
