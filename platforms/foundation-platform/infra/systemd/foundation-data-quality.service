[Unit]
Description=Foundation Platform data quality: run the data contracts' executable checks and report them as Dagster asset checks (root ADR-0609 §2, ADR-0123)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/data-catalog.md
X-Foundation-Owner=lakehouse
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
# Its docker calls read the account's own config, not $HOME/.docker under /nonexistent (scripts/ops/admitted-writer-runtime.sh).
Environment=DOCKER_CONFIG=/var/lib/foundation-platform/docker-config
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=-/etc/foundation-platform/operations-map.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/data-quality-check.py
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# DuckDB's database and spill while it counts (lakehouse-query, root ADR-0565).
StateDirectory=foundation-data-quality
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=4294967296

[Install]
WantedBy=multi-user.target
