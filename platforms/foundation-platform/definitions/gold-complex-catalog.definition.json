{
  "$schema": "scripts/catalog/definition.v1.schema.json",
  "definition": "foundation-platform.definition.v1",
  "group": "gold-complex-catalog",
  "jobs": [
    {
      "id": "gold_complex_catalog_versions_build",
      "dagster_group": "gold",
      "scope": "changed-keys",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "The industrial-complex catalog as a table of appended row versions (root ADR-0426, ADR-0564 §1-§2; scripts/ops/gold-versions-build.sh complex-catalog → publisher build-complex-catalog-versions): gold.complex_catalog_versions, each complex's current row of silver.industrial_complexes with its 시도·시군구 carried to the current codes through the pairs in force and the current 시도's name, computed by DuckDB inside the publisher in one whole-table pass (1,442 rows, 2026-11-22: the declared exception to the 시도 loop and to a partition) and appended as the complexes whose row_digest changed, each commit one version_seq. While the canonical load and the profile and edge exports read gold.complex_catalog it is that table's shadow: the table was built by hand and tags no build, so it follows that table's newest commit that is not a compaction and reads each input as of that commit; the takeover verdict (the check takeover_equal on 시도 41, by sido_code) compares the two engines over one set of inputs. Nothing to do when the base commit was built from the same pins and code. Nothing reads it until the switch.",
      "systemd_service": "foundation-gold-versions@complex-catalog.service",
      "systemd_timer": null,
      "state_paths": [],
      "schedule": "35 10 * * *",
      "started_by": "inputs",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 60,
      "memory_max": "8G",
      "memory_measured_peak": "7373M",
      "memory_measured": "its own: run 20261119T152616Z of foundation-gold-versions@parcel-nearby (2026-11-19 15:26-15:51Z, every served parcel, 39,861,511 rows committed in 1500 s), systemd's memory peak 7.2G, swap peak 13.5M; the publisher's own peak in its run log 7,733,563,392 bytes",
      "memory_headroom_why": "The peak follows the cap, not the work: the publisher gives DuckDB three fifths of what the unit has left under MemoryHigh (duckdb_parquet_stage MEMORY_SHARE) and DuckDB fills it and the page cache, so a larger memory_max would only raise the peak. The run fit: no timeout, 13.5M swap, under MemoryMax",
      "disk_max": "8G",
      "disk_measured": "not measured: the build runs in the gold-versions@ template, whose bound (8G) covers every lane's stage database and staged files; its own stage holds far less, one pass over the industrial-complex Silver tables and the legal-dong names that writes about 1,442 rows. The stage logs `duckdb stage closed: disk_bytes=<n>` as it closes (root ADR-0622); a pull request replaces this bound with the highest logged value, nothing is kept between runs.",
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": null,
        "first_run": {
          "estimate_seconds": 120,
          "estimated_from": "computed, not measured: the build reads silver.industrial_complexes at one snapshot (4,326 rows of 1,442 complexes on its 2026-10-01 snapshot), the legal-dong code changes (about 3,500 rows) and the newest 법정동 snapshot (about 53,000 rows, the read the Spark job made, read_region_inputs) and writes at most 1,442 rows: under two minutes, most of it the catalog's round trips."
        }
      },
      "pool": "duckdb",
      "memory_claim": {
        "units": [
          "foundation-gold-versions@complex-catalog.service"
        ]
      },
      "priority_weight": 20,
      "retries": 0,
      "pipeline_graph_edges": [
        "silver-industrial-complexes-to-gold-complex-catalog-versions",
        "reference-legal-dong-code-change-to-gold-complex-catalog-versions",
        "reference-legal-dong-code-snapshot-to-gold-complex-catalog-versions",
        "gold-complex-catalog-to-gold-complex-catalog-versions"
      ],
      "enabled": true,
      "enabled_since": "2026-11-26T00:00:00Z",
      "dagster_stage": "dagster",
      "expected_outcome": {
        "changes_within_hours": null,
        "no_change_bound_reason": "Changes only when its inputs moved. That it is not behind them is the asset reconciler's lag (root ADR-0333); a change bound here would report a source that published nothing."
      }
    }
  ],
  "assets": [
    {
      "id": "gold-complex-catalog",
      "type": "gold_table",
      "title": "산업단지 제공용 프로필",
      "description": "저장소에 변환 실행 경로가 있다. 운영 적재량·최신 성공 여부는 실행 원장에서 확인한다.",
      "status": "implemented",
      "runbook_ref": "platforms/foundation-platform/docs/runbooks/lakehouse-compute-engines.md",
      "owner": "foundation-platform",
      "evidence_refs": [
        "platforms/foundation-platform/infra/lakehouse/contracts/industrial_complex_lakehouse_contracts.json"
      ],
      "table_name": "gold.complex_catalog",
      "runtime_bindings": [
        {
          "kind": "lakehouse_contract",
          "value": "gold.complex_catalog"
        }
      ]
    },
    {
      "id": "gold-complex-catalog-versions",
      "type": "gold_table",
      "title": "산업단지 목록(판을 쌓는 표)",
      "description": "산업단지 목록을 판을 쌓는 표로(루트 ADR-0426, ADR-0564 §1·§2): gold.complex_catalog 의 칸에 row_digest·version_seq·row_state 를 더해 내용이 바뀐 단지의 행만 덧붙인다. 현재 행은 단지마다 version_seq 가 가장 큰 행이고 row_state 가 removed 면 그 단지는 없다. 1,442행이라 나눔(partition) 없이 한 번에 짓는다. 발행기 안의 DuckDB 가 계산하고 발행기가 추가 커밋으로 붙인다. 읽는 쪽이 옛 표를 읽는 동안은 그 표의 그림자다(옛 표의 가장 새 커밋 시각의 입력으로 짓는다, 루트 ADR-0564 §6).",
      "status": "implemented",
      "owner": "foundation-platform",
      "evidence_refs": [
        "platforms/foundation-platform/definitions/gold-complex-catalog.definition.json",
        "platforms/foundation-platform/crates/publisher/foundation-publisher-silver/src/complex_catalog_stage.rs",
        "platforms/foundation-platform/services/foundation-outbox-publisher/src/complex_catalog_versions_build.rs"
      ],
      "table_name": "gold.complex_catalog_versions",
      "runtime_bindings": [
        {
          "kind": "lakehouse_contract",
          "value": "gold.complex_catalog_versions"
        }
      ]
    }
  ],
