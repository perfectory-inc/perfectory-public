# Root ignores (belt-and-suspenders over each area's own .gitignore).
# Rust build output — anywhere in the monorepo, including tools/xtask.
target/

# Node / frontend
node_modules/
.pnpm-store/

# Python bytecode
__pycache__/
*.py[cod]

# Local env & secrets (never commit; secret-scan + these lines are the guard)
.env
.env.local
.env.*.local
# Timestamped backups of the above. A rotation left
# `.env.local.bak-20260806T004029Z` tracked-visible in a repository whose remote
# is public: the exact name is ignored while every copy of it was not. Prefix
# match, not a longer list of suffixes, because the next backup will be named by
# whatever tool makes it.
.env.local.*
.env.*.local.*

# OS / editor cruft
.DS_Store
Thumbs.db

# Internal agent plans/specs stay local; maintained decisions belong in docs/adr or runbooks.
docs/superpowers/
