[Unit]
Description=Foundation Platform VWorld 필지고유번호변동연혁 (MK/30527), the collection half: land the 시도 files whose provider update date changed in Bronze, check them, stage a pending-load handoff (ADR-0144)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/legal-dong-code-changes.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/parcel-number-change-collect.sh
TimeoutStartSec=45m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/parcel-number-change
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0454); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
