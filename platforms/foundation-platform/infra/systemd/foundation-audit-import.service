[Unit]
Description=Foundation Platform audit import: append the deploys and the operators' host commands to the audit chain audit.event (root ADR-0569)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/audit-log.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
# The journal's operator starts (root ADR-0569 §6); the deploy state and the git mirror are
# world-readable, and ProtectSystem=strict keeps every path read-only.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
ExecStart=/opt/foundation-platform/current/scripts/ops/audit-import.sh
# A oneshot run is capped by its start timeout; systemd ignores RuntimeMaxSec= on Type=oneshot.
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824

[Install]
WantedBy=multi-user.target
