[Unit]
Description=Foundation Platform 주소DB from the juso.go.kr public download, no login: the monthly full once as the base, then each day's change file into Bronze (root ADR-0495)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/juso-address-db.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/juso-address-db-cycle.sh
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/juso-address-db
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
