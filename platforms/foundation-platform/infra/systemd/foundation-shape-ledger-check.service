[Unit]
Description=Foundation Platform shape ledger check: the committed production-shape ledgers still describe production (ADR-0259)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/shape-ledger-bucket.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=-/etc/foundation-platform/operations-map.env
EnvironmentFile=-/etc/foundation-platform/shape-ledger.env
ExecStart=/opt/foundation-platform/current/scripts/ops/shape-ledger-check.py
StateDirectory=foundation-shape-ledger
TimeoutStartSec=15m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
