[Unit]
Description=Foundation Platform: start each operator run-now request once, before it expires, and stop what an operator stopped (root ADR-0282 §4, §5)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/asset-reconcile.md
X-Foundation-Owner=platform
Requires=docker.service
After=docker.service
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
# Root, like the deploy: it triggers a DAG through airflow-runtime.sh as the deploy account.
ExecStart=/bin/bash /opt/foundation-platform/current/scripts/ops/run-now-dispatch.sh
StateDirectory=foundation-run-now
TimeoutStartSec=5m
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=0
