[Unit]
Description=Foundation Platform weekly synthetic screen: for real PNUs, GET every section a parcel's screen shows and hold each lane to its freshness budget (root ADR-0480)
X-Foundation-Owner=serving
# What a failure means and the first checks; notify-unit-failure.sh puts it in the Slack notice.
Documentation=file:///opt/foundation-platform/current/docs/runbooks/job-outcomes.md
After=network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service
OnSuccess=foundation-unit-recovered@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# Each lane's gate sample path, written at its cut-over: the PNUs are read on the host, never from the
# repository. The probe reads only public hostnames and the metrics textfiles.
EnvironmentFile=-/etc/foundation-platform/building-serving-monitor.env
EnvironmentFile=-/etc/foundation-platform/parcel-serving-monitor.env
EnvironmentFile=-/etc/foundation-platform/unit-price-serving-monitor.env
EnvironmentFile=-/etc/foundation-platform/by-pnu-kind-serving-monitor.env
ExecStart=/usr/bin/python3 -I /opt/foundation-platform/current/scripts/ops/by-pnu-edge-probe.py --screen
# About one PNU per cut-over lane times every lane: some 450 reads of at most 20 s each.
TimeoutStartSec=45m
# The standard library and one document at a time, as the edge probe.
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=115M
MemoryMax=128M
OOMScoreAdjust=0
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-jobs/metrics
