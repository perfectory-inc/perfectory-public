{
  "$schema": "scripts/catalog/definition.v1.schema.json",
  "definition": "foundation-platform.definition.v1",
  "group": "court-auction-collect",
  "jobs": [
    {
      "id": "court_auction_collect",
      "scope": "full",
      "full_reason": "Every night it walks every list search page by page: the site offers no changed-since query.",
      "full_cost": "measured from the unit journal: 2026-10-19 one pass at one request every 3 seconds took 78 minutes (16:02-17:20 UTC); 2026-11-06 the same collector read ipcheck=false as a refusal after 1,528 requests in 87 minutes and every later run refused to start (root ADR-0289 replaces both: a list pass is about 2,500 pages at the contract's adaptive pace, measured on 2026-10-21 by the prototype at about 8 minutes).",
      "full_tracked_by": "root ADR-0352: the recrawl frontier is computed each run from the lakehouse, so a night asks only for what is not yet known or is due again",
      "interruptible": false,
      "commits": "at_end",
      "description": "법원경매정보 list searches (root ADR-0280, ADR-0289; scripts/ops/court-auction-collect.sh): the item search's four combinations and the sale-result search's two, every page, asked as a browser on a pool of sessions at the adaptive pace of the contract (courtauction-go-kr.contract.json collection.session and collection.pace). A block (the site's ipcheck=false, a redirect, HTML where JSON belongs) is not a refusal: the blocked session is renewed after the contract's wait and the page asked again, with no bound and no person to clear anything. Any hour, unless an operator narrows the hours for a bounded time (switches/court_auction_collect.window, root ADR-0282). When the list pass was not cut short, the same run asks the due 물건상세 on the same pool at the goods_detail pace (root ADR-0384), stores each photo once in the shared media store and, after the run's Bronze lands, makes their display ladders within the contract's budget, whose seconds the detail asking leaves free inside the run's time budget (root ADR-0427 §7). The run's time budget is its only early end; a run that got no answer at all fails. Hands nothing on: court_auction_silver finds what it owes in R2. No Spark.",
      "systemd_service": "foundation-court-auction-collect.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/court-auction"
      ],
      "schedule": "5 16 * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 300,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": "infra/lakehouse/contracts/courtauction-go-kr.contract.json#/collection/session/run_time_budget_seconds",
        "measured_run_seconds": {
          "runs": 2,
          "p50": 610,
          "p90": 4666,
          "max": 4666,
          "timeouts": 0,
          "from": "2026-10-19T16:02:34Z",
          "to": "2026-11-03T15:50:32Z"
        }
      },
      "pool": "default_pool",
      "retries": 0,
      "pipeline_graph_edges": [
        "source-courtauction-go-kr-to-silver-court-auction-item",
        "source-courtauction-go-kr-to-silver-court-auction-sale-result",
        "source-courtauction-go-kr-to-silver-court-auction-item-detail",
        "source-courtauction-go-kr-to-silver-court-auction-item-photo",
        "silver-court-auction-item-detail-to-source-courtauction-go-kr",
        "source-courtauction-go-kr-to-silver-court-auction-code",
        "source-courtauction-go-kr-to-silver-court-auction-case-document-read",
        "source-courtauction-go-kr-to-silver-court-auction-case-related",
        "source-courtauction-go-kr-to-silver-court-auction-case-object",
        "source-courtauction-go-kr-to-silver-court-auction-case-party",
        "source-courtauction-go-kr-to-silver-court-auction-survey",
        "source-courtauction-go-kr-to-silver-court-auction-survey-object",
        "source-courtauction-go-kr-to-silver-court-auction-appraisal",
        "silver-court-auction-case-document-read-to-source-courtauction-go-kr",
        "source-courtauction-go-kr-to-silver-court-auction-appraisal-report",
        "source-courtauction-go-kr-to-silver-court-auction-appraisal-report-read",
        "silver-court-auction-appraisal-to-source-courtauction-go-kr",
        "silver-court-auction-appraisal-report-to-source-courtauction-go-kr",
        "silver-court-auction-appraisal-report-read-to-source-courtauction-go-kr"
      ],
      "enabled": true,
      "enabled_since": "2026-10-30T13:30:00Z",
      "dagster_stage": "shadow",
      "expected_outcome": {
        "changes_within_hours": 54,
        "basis": "court sale notices change every day (expected_cadence daily, 30 h); two daily turns. measured 2026-11-11 from each unit's journal, 10-12..11-11 (read-only): longest gap 479.1 h, the 10-19..11-07 refusal (root ADR-0446), which this bound reports on its third day."
      }
    }
  ],
