      "status": "contract_only",
      "owner": "foundation-platform",
      "evidence_refs": [
        "platforms/foundation-platform/infra/lakehouse/contracts/industrial_complex_lakehouse_contracts.json",
        "platforms/foundation-platform/infra/lakehouse/contracts/courtauction-go-kr.contract.json"
      ],
      "table_name": "silver.court_auction_sale_result",
      "runtime_bindings": [
