# Pinned Opengrep release: the LGPL fork of the Semgrep engine (same rule YAML, same `--test`
# fixtures), published as one checksummed static binary per platform, which is what the one pinned
# fetcher (scripts/ci/fetch_pinned.py, root ADR-0197) downloads. Semgrep CE itself is only on PyPI
# (a wheel and its dependency tree), so it cannot be pinned the same way.
OPENGREP_VERSION=1.33.1
