[Unit]
Description=Foundation Platform map edit fold for the %i unit: bake admin polygon edits into its tiles (ADR-0112)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/map-edit-fold.md
X-Foundation-Owner=tiles
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
ExecStart=/opt/foundation-platform/current/scripts/ops/map-edit-fold.sh %i
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/map-edit-fold
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=691M
MemoryMax=768M
OOMScoreAdjust=500
