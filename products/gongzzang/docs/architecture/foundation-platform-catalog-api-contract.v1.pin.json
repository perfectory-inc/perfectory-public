{
  "schema_version": "gongzzang.foundation_platform_catalog_api_contract_pin.v1",
  "source_repo": "foundation-platform",
  "source_path": "docs/openapi/catalog.v1.json",
  "snapshot_path": "crates/foundation-platform-client/openapi/catalog.v1.json",
  "source_sha256": "29d37348049694be50bd5386a2a2d5dd5da1903a60a3ad69348998d5c91ede3c",
  "source_schema_version": "foundation-platform.openapi.catalog.v1",
  "consumer_slug": "gongzzang",
  "base_env": "FOUNDATION_PLATFORM_API_BASE_URL",
  "schemas": {
    "pnu": {
      "type": "string",
      "length": 19,
      "pattern": "^[0-9]{10}[1289][0-9]{8}$"
    }
  },
  "allowed_reference_modules": ["services/gongzzang-api/src/startup.rs"],
  "parcel_detail_note": "Parcel by-pnu detail is no longer consumed from this OpenAPI contract: root ADR-0109 moved it to the public R2 edge (catalog.perfectory.io/parcels/by-pnu/{pnu}), served from gold.parcel_panel and read by services/gongzzang-api/src/foundation_parcel_lookup.rs. The edge is not OpenAPI-described, so its object shape is guaranteed by the bake + edge-serving checks (root ADR-0096), not by this pin.",
  "endpoints": [
    {
      "operation_id": "getComplexByLakehouseId",
      "transport_module": "crates/foundation-platform-client/src/catalog.rs",
      "adapter_module": "services/gongzzang-api/src/complex_reader.rs",
      "method": "GET",
      "path_template": "/catalog/v1/complexes/by-lakehouse-id/{lakehouse_complex_id}",
      "path_pattern_literal": "catalog/v1/complexes/by-lakehouse-id/",
      "success_shape": "object",
      "not_found_behavior": "none",
      "required_response_fields": ["official_complex_code", "name", "kind", "area_m2"]
    },
    {
      "operation_id": "listComplexes",
      "transport_module": "crates/foundation-platform-client/src/catalog.rs",
      "adapter_module": "services/gongzzang-api/src/complex_reader.rs",
      "method": "GET",
      "path_template": "/catalog/v1/complexes",
      "path_pattern_literal": "catalog/v1/complexes",
      "success_shape": "object",
      "not_found_behavior": "none",
      "required_response_fields": ["complexes", "total", "page", "size", "has_next"]
    },
    {
      "operation_id": "listParcelBuildingsByPnu",
      "transport_module": "crates/foundation-platform-client/src/catalog.rs",
      "adapter_module": "services/gongzzang-api/src/building_reader.rs",
      "method": "GET",
      "path_template": "/catalog/v1/parcels/by-pnu/{pnu}/buildings",
      "path_pattern_literal": "catalog/v1/parcels/by-pnu/{}/buildings",
      "success_shape": "array",
      "required_response_fields": [
        "id",
        "parcel_id",
        "below_ground_floors",
        "has_rooftop",
        "rooftop_usage",
        "updated_at"
      ]
    }
  ]
}
