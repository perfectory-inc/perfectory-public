[Unit]
Description=Foundation Platform industrial-complex canonical load: write the current rows of the catalog's versions table into catalog.industrial_complex (root ADR-0040, ADR-0426, ADR-0564)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/lakehouse-compute-engines.md
X-Foundation-Owner=lakehouse
After=network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-complex-canonical-load.sh
TimeoutStartSec=15m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-complex-canonical
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824

[Install]
WantedBy=multi-user.target
