[Unit]
Description=Restore the newest PostgreSQL backup and its WAL into throwaway volumes and compare it with the live database
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
Environment=FOUNDATION_RECOVERY_EVIDENCE_DIR=/var/lib/foundation-platform/recovery
EnvironmentFile=/etc/foundation-platform/recovery.env
ExecStart=/opt/foundation-platform/current/scripts/recovery/run-postgres-restore-drill.sh
# Measured by hand on 2026-10-14: 23 minutes to restore 130.1GB, 11 seconds to promote. Twice that,
# plus the script's own 30-minute wait for recovery, fits; a drill stuck longer fails and reports.
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/recovery
