# Pinned Docker Compose release: the standalone binary that normalizes every Compose file for the
# Conftest policies in tools/conftest/compose (scripts/guard/check-container-runtime-policy.sh).
# Pinned rather than taken from the runner, because the parser is part of the policy: a runner's
# older Compose refused the un-interpolated `${NAME:-./path}:/target:ro` volume form this one reads.
DOCKER_COMPOSE_VERSION=5.1.0
DOCKER_COMPOSE_LINUX_X86_64_SHA256=5633cb21e06a7c88c7ca48a9334d3d0f7f892e9605ae9e9a45f9a095d4ffceb8
