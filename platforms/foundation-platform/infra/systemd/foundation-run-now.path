[Unit]
Description=Start an operator's run-now request or stop when foundation-api writes one (root ADR-0282 §4, §5)

[Path]
# foundation-api writes a request whole (a temporary file, then a rename into the directory).
PathChanged=/var/lib/foundation-jobs/switches/run-now.d
# A stop is <job>.stop in the switch directory itself.
PathChanged=/var/lib/foundation-jobs/switches
Unit=foundation-run-now.service

[Install]
WantedBy=paths.target
