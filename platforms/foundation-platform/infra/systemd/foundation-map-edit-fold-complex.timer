[Unit]
Description=Fold industrial complex polygon edits into the tiles every hour (ADR-0112)

[Timer]
# Each unit folds at its own minute so two Spark runs and two bakes never share the host.
OnCalendar=*-*-* *:05:00
Persistent=true
RandomizedDelaySec=5m
Unit=foundation-map-edit-fold@complex.service

[Install]
WantedBy=timers.target
