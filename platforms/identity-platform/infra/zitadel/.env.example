# Zitadel LAN production stack (root ADR-0080). Copy to the host env file the
# zitadel-runtime.sh wrapper reads and fill every value; blanks are rejected.
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=ops-admin
ZITADEL_ADMIN_PASSWORD=
ZITADEL_ADMIN_EMAIL=
# The bootstrap machine PAT is read once at bring-up and then stored under the
# host secrets directory; give it a bounded lifetime, not a forever date.
ZITADEL_BOOTSTRAP_PAT_EXPIRATION=2027-12-31T00:00:00Z
