[Unit]
Description=Restore the PostgreSQL backup into throwaway containers and prove the data and PITR marker come back
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
Environment=FOUNDATION_RECOVERY_EVIDENCE_DIR=/var/lib/foundation-platform/recovery
EnvironmentFile=/etc/foundation-platform/recovery.env
ExecStart=/opt/foundation-platform/current/scripts/recovery/postgres-restore-drill.sh
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/recovery
