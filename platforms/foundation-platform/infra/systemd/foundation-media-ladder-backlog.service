[Unit]
Description=Foundation Platform photo ladder backlog: the display ladders a collector run left, made from the Silver photo indexes (root ADR-0429)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/media-reconcile.md
X-Foundation-Owner=serving
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=-/etc/foundation-platform/operations-map.env
ExecStart=/opt/foundation-platform/current/scripts/ops/media-ladder-backlog.sh
# The job list's time_limit_minutes (jobs.v1.json): the ladder budget (1,500 s) and the index read.
TimeoutStartSec=40m
TimeoutStopSec=30
# Four sources decoded and AV1-encoded at a time (a 50-megapixel cap each, root ADR-0427 §2).
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=2764M
MemoryMax=3G
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/media-ladder-backlog

[Install]
WantedBy=multi-user.target
