[Unit]
Description=Foundation Platform 주소정보 전자지도 daily changes from the juso.go.kr data linkage: land each day's files in Bronze per kind, backfilling from 2020 under a per-run cap (root ADR-0475)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/juso-electronic-map.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=-/etc/foundation-platform/juso.env
ExecStart=/opt/foundation-platform/current/scripts/ops/juso-electronic-map-cycle.sh
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/juso-electronic-map
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=2764M
MemoryMax=3G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
