[Unit]
Description=Foundation Platform 산업입지정보시스템 산업단지 목록·고시 목록·상세, the address source of silver.industrial_complexes: land them in Bronze (root ADR-0033)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/lakehouse-compute-engines.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-complex-address-source-collect.sh
# The job list's time_limit_minutes (jobs.v1.json).
TimeoutStartSec=15m
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-complex-address-source
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
