  "group": "admin-boundary-release",
  "jobs": [
    {
      "id": "admin_boundary_release",
      "scope": "skip-if-unchanged",
      "interruptible": true,
      "commits": "as_it_goes",
      "description": "Load the newest 읍면동 boundary round into Silver, publish its place ids and fold it into the admin tiles (root ADR-0236; scripts/ops/admin-boundary-release.sh): read the round from the members of the boundary ZIPs the daily sweep collects, and if silver.administrative_boundaries already holds it, republish only the admin place-id release when the legal-dong code-change pairs moved it (root ADR-0288 §3: a 분구's old dong codes reach the bridge only from the pairs; `changed`), else `unchanged`; otherwise convert that round's ZIPs, merge them against the official code list, append the snapshot (a renumbered dong keeps its id), publish the admin place-id release and rebake the admin tiles with the hourly fold's own script. A round missing a sido is waited for (`unchanged`), not failed. Started when a source_sweep run lands new files, and daily as the fallback; it holds every spark slot, so it never runs beside a fold.",
      "systemd_service": "foundation-admin-boundary-release.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/map-edit-fold"
      ],
      "schedule": "30 9 * * *",
      "started_by": "inputs",
      "stop_grace_minutes": 10,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 120,
      "per_run_cap": {
        "unit": "run",
        "limits": [],
        "deadline": null,
        "measured_run_seconds": {
          "runs": 43,
          "p50": 47,
          "p90": 85,
          "max": 393,
          "timeouts": 0,
          "from": "2026-10-16T03:56:08Z",
          "to": "2026-11-03T15:50:32Z"
        }
      },
      "pool": "spark",
      "pool_slots": 3,
      "priority_weight": 2,
      "retries": 0,
      "pipeline_graph_edges": [
        "source-vworld-dataset-to-silver-administrative-boundaries",
        "reference-legal-dong-code-change-to-silver-administrative-boundaries",
        "silver-administrative-boundaries-to-gold-place-id-registry",
        "silver-administrative-boundaries-to-gold-place-id-bridge",
        "silver-administrative-boundaries-to-gold-place-id-changelog"
      ],
