[Unit]
Description=Restore the identity database backups into throwaway containers and log in to the restored Zitadel
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
Environment=FOUNDATION_RECOVERY_EVIDENCE_DIR=/var/lib/foundation-platform/recovery
EnvironmentFile=/etc/foundation-platform/recovery.env
# A live Zitadel token: only a request the restored Zitadel must decrypt proves its masterkey.
LoadCredential=zitadel-token:/etc/identity-platform/secrets/zitadel-bootstrap-pat
ExecStart=/opt/foundation-platform/current/scripts/recovery/identity-restore-drill.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/recovery
