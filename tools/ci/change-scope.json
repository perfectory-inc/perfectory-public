  "unscoped": {
    "docs.yml": {
      "reason": "A link fix in one area can break a link in another, and the generated documents read every area; the whole job takes about two minutes.",
      "owns": [
        "docs/**",
        "**/*.md",
        "lychee.toml"
      ]
    },
    "secret-scan.yml": {
      "reason": "A secret can arrive in any path; scanning every change is the point of the check.",
      "owns": [
        ".gitleaks.toml"
      ]
    },
    "monorepo-guard.yml": {
      "reason": "Repository-wide invariants (layout, versions, workflow policy, supply chain) read every area.",
      "owns": [
        "scripts/guard/**",
        "scripts/github/**",
        "tools/github/**",
        "lefthook.yml",
        "REUSE.toml",
        "LICENSES/**"
      ]
    },
    "foundation-ci.yml": {
      "reason": "Selects its own heavy gates per job with scripts/ci/foundation_ci_scope.py; adopting this area scope there is a separate change to jobs another change is reshaping.",
      "owns": [
        "platforms/foundation-platform/**"
      ]
    }
  },
  "crates": {
    "$comment": "Which crates of a Cargo workspace a pull request verifies (root ADR-0269). `cargo xtask verify|integration <area> --affected` asks `change_scope.py crates --workspace <dir>`. A changed path selects the member whose directory holds it, then every member whose Rust sources name it (or a directory above it) in quotes, then every member that depends on those (nextest's rdeps()). Only a pull request narrows: a push to main, the merge queue, the nightly run and a manual run verify every crate. A path matching `run_all` (from the repository root) or `run_all_in_workspace` (from the workspace directory), Rust outside every member, the selector or this file verifies every crate.",
    "run_all": [
      "**/Cargo.lock",
      "rust-toolchain.toml",
      ".cargo/config.toml",
      "tools/xtask/**",
      ".github/workflows/**",
      "tools/cargo-nextest.env",
      "tools/pinned-artifacts.json",
      "scripts/ci/rust-setup.sh"
    ],
    "run_all_in_workspace": [
      "Cargo.toml",
      ".config/**",
      "clippy.toml",
      "rustfmt.toml"
    ]
  },
  "guards": {
