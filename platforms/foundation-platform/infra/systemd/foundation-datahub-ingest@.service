[Unit]
Description=Foundation Platform data catalog: read %i into DataHub (infra/datahub/recipes/%i.yml, root ADR-0117 §3)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/data-catalog.md
X-Foundation-Owner=lakehouse
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# lakehouse-iceberg reads the catalog with its read-only token and the tables' metadata files with the
# lakehouse read-only key pair; data-contracts reads only the release's contracts/data. Nothing here
# can write the lakehouse (root ADR-0152).
EnvironmentFile=-/etc/foundation-platform/operations-map.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/deploy/datahub-runtime.sh ingest %i
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
