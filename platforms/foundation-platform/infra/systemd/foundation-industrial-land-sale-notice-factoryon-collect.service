[Unit]
Description=Foundation Platform 공장설립온라인 분양 및 처분신청 공고와 첨부, the collection half at the owner's least load: once a day, seven seconds between requests, stopping at once on a refusal (root ADR-0603 §8)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/industrial-land-sale-notice.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=-/etc/foundation-platform/operations-map.env
ExecStart=/opt/foundation-platform/current/scripts/ops/industrial-land-sale-notice-collect.sh factoryon
# The job list's time_limit_minutes (jobs.v1.json): this source's budget (12,600 s) and one notice.
TimeoutStartSec=240m
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/industrial-land-sale-notice
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
