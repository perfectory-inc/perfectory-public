{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundation-tile-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-26",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "tiles.perfectory.io",
      "custom_domain": true
    },
    {
      "pattern": "tiles.gongzzang.app",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOUNDATION_PLATFORM_TILE_DERIVATIVES",
      "bucket_name": "foundation-platform-tile-derivatives-prod"
    }
  ]
}
