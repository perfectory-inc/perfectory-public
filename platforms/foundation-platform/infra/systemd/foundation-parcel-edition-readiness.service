[Unit]
Description=Foundation Platform cadastral edition readiness: judge each edition the source contract holds, only those whose inputs moved, and write the report the operator console shows (ADR-0379, ADR-0380)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/vworld-parcel-editions.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# Root ADR-0490 §5: a 20-minute R2 key for parcel-editions/ of the ledger bucket only, minted as root from
# the control checkout into the RuntimeDirectory (root ADR-0476 §3); the job copies the host promotions
# ledger there for CI. The job's own process never sees the account token.
ExecStartPre=+/usr/bin/python3 /opt/perfectory-control/current/platforms/foundation-platform/scripts/ops/shape-ledger-writer-key.py parcel-editions/
ExecStart=/opt/foundation-platform/current/scripts/ops/parcel-edition-readiness.sh
RuntimeDirectory=foundation-parcel-edition-readiness
RuntimeDirectoryMode=0700
# Measured 2026-11-04: the partition metadata query and both judgements together take seconds.
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The second path: the served edition's lag as textfile series (root ADR-0490 §3).
ReadWritePaths=/var/lib/foundation-platform/parcel-editions /var/lib/foundation-jobs/metrics
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=921M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
