[Unit]
Description=Foundation Platform ADR-0275 step 1: measure one land transfer history release appended as changes, phase by phase, in a scratch namespace (disabled; operator job start)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
ExecStart=/opt/foundation-platform/current/scripts/ops/silver-append-measure.sh
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/lineage-stewardship /var/lib/foundation-platform/lakehouse-ivy
