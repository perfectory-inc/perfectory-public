[Unit]
Description=Report the failure of %i to Slack

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
ExecStart=/opt/foundation-platform/current/scripts/ops/notify-unit-failure.sh %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0454); do not edit.
MemoryHigh=230M
MemoryMax=256M
OOMScoreAdjust=0
