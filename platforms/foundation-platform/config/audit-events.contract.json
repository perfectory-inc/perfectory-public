{
  "$comment": "The vocabulary of the audit chain audit.event (root ADR-0569 §2, §3). writers is the table audit.source as data: the role that may write each source through audit.append, and whether that source verified the actor it names (an importer's actor_verified is true only for a source that verifies). The migration that creates audit.event spells the same lists as its CHECKs and audit.source rows; orchestration/tests/test_audit_events_contract.py refuses any difference, and every action the migrations emit must be listed here. A new source or action is a migration and a change here, in one PR. The importer (import-audit-events, root ADR-0569 §6) reads this file from the release it runs in: a host command whose action is not listed here is recorded as host_command.other, with no arguments.",
  "schema_version": "foundation.audit-events.v1",
  "writers": [
    { "source": "dawneer", "writer_role": "foundation_api", "verifies_actor": true },
    { "source": "audit", "writer_role": "foundation_api", "verifies_actor": true },
    { "source": "audit", "writer_role": "foundation_audit_importer", "verifies_actor": false },
    { "source": "github", "writer_role": "foundation_audit_importer", "verifies_actor": true },
    { "source": "merge_queue", "writer_role": "foundation_audit_importer", "verifies_actor": true },
    { "source": "deploy", "writer_role": "foundation_audit_importer", "verifies_actor": false },
    { "source": "host_command", "writer_role": "foundation_audit_importer", "verifies_actor": false },
    { "source": "repo_settings", "writer_role": "foundation_audit_importer", "verifies_actor": true },
    { "source": "identity", "writer_role": "foundation_audit_importer", "verifies_actor": true }
  ],
  "operations": ["create", "modify", "remove", "execute", "access"],
  "actor_kinds": ["staff", "service", "system", "unlinked"],
  "results": ["requested", "succeeded", "failed", "refused", "expired"],
