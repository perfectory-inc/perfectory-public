[Unit]
Description=Foundation Platform data.go.kr file %i, collected by its own job: land each new edition and the earlier editions not yet landed in Bronze as received (root ADR-0604)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/data-go-kr-registered-factory.md
X-Foundation-Owner=collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
ExecStart=/opt/foundation-platform/current/scripts/ops/data-go-kr-file-collect.sh %i
TimeoutStartSec=1h
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/data-go-kr-file-collect
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=1843M
MemoryMax=2G
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824

[Install]
WantedBy=multi-user.target
