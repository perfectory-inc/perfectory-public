{
  "$schema": "scripts/catalog/definition.v1.schema.json",
  "definition": "foundation-platform.definition.v1",
  "group": "court-auction-collect",
  "jobs": [
    {
      "id": "court_auction_collect",
      "scope": "full",
      "full_reason": "Every night it walks every list search page by page: the site offers no changed-since query.",
      "full_cost": "measured from the journal of its supervised nights (the job is disabled since): 2026-10-19 one night took 78 minutes (16:02-17:20 UTC); 2026-10-20 the site refused it after 174 requests in 10 minutes.",
      "full_tracked_by": "root ADR-0352: the recrawl frontier is computed each run from the lakehouse, so a night asks only for what is not yet known or is due again",
      "interruptible": false,
      "commits": "at_end",
      "description": "법원경매정보 list searches (root ADR-0280, ADR-0281; scripts/ops/court-auction-collect.sh): robots.txt, then the item search's four combinations and the sale-result search's two, page by page, one request at a time at least 3 seconds apart, identified by our product name, only between 01:00 and 06:00 KST unless an operator overrides that window for a bounded time (switches/court_auction_collect.window, root ADR-0282), and within a per-night request bound (courtauction-go-kr.contract.json). Any refusal signal stops the night, lands what was collected and blocks later nights until a person clears it. Hands nothing on: court_auction_silver finds what it owes in R2. No Spark.",
      "systemd_service": "foundation-court-auction-collect.service",
      "systemd_timer": null,
      "state_paths": [
        "/var/lib/foundation-platform/court-auction"
      ],
      "schedule": "5 16 * * *",
      "started_by": "schedule",
      "stop_grace_minutes": 5,
      "wait_limit_minutes": 0,
      "time_limit_minutes": 300,
      "per_run_cap": {
        "unit": "request",
        "limits": [
          "infra/lakehouse/contracts/courtauction-go-kr.contract.json#/manners/max_requests_per_run",
          "infra/lakehouse/contracts/courtauction-go-kr.contract.json#/item_detail/photos/renditions/per_run_limit"
        ],
        "deadline": null,
        "measured_run_seconds": {
          "runs": 2,
          "p50": 610,
          "p90": 4666,
          "max": 4666,
          "timeouts": 0,
          "from": "2026-10-19T16:02:34Z",
          "to": "2026-11-03T15:50:32Z"
        }
      },
      "pool": "default_pool",
      "retries": 0,
      "pipeline_graph_edges": [
        "source-courtauction-go-kr-to-silver-court-auction-item",
        "source-courtauction-go-kr-to-silver-court-auction-sale-result",
        "source-courtauction-go-kr-to-silver-court-auction-item-detail",
        "source-courtauction-go-kr-to-silver-court-auction-item-photo",
        "silver-court-auction-item-detail-to-source-courtauction-go-kr"
      ],
      "enabled": true,
      "enabled_since": "2026-10-30T13:30:00Z",
      "dagster_stage": "shadow"
    }
  ],
  "assets": [
    {
      "id": "silver-court-auction-item",
      "type": "silver_table",
      "title": "법원경매 진행 물건",
      "description": "물건(법원·사건·물건번호·목록번호)마다 내용이 바뀐 행을 쌓고, 완전한 전수에서 빠진 물건에 삭제 표지를 쌓는다. 주소로 찾은 PNU 와 그 단계를 남긴다(루트 ADR-0280). 이 행을 보여 주는 소비자는 출처(대한민국법원 법원경매정보)를 구체적으로 표시해야 한다(저작권 보호정책, 저작권법 제24조의2; 루트 ADR-0281 §6). 적재 레인은 돌고, 필지 경매 종류 표(gold.parcel_court_auction)가 읽는다(루트 ADR-0353).",
      "status": "implemented",
      "owner": "foundation-platform",
      "evidence_refs": [
        "platforms/foundation-platform/infra/lakehouse/contracts/industrial_complex_lakehouse_contracts.json",
        "platforms/foundation-platform/infra/lakehouse/contracts/courtauction-go-kr.contract.json"
      ],
      "table_name": "silver.court_auction_item",
      "runtime_bindings": [
        {
          "kind": "lakehouse_contract",
          "value": "silver.court_auction_item"
        }
      ]
    },
    {
      "id": "silver-court-auction-sale-result",
