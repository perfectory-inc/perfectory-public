[Unit]
Description=Foundation Platform parcel tile bake, %i half: the matching gate and served Gold (gold), or bake, gate and promote it (bake); rehearsal-gold and rehearsal-bake do the same for the newest edition and serve nothing (ADR-0133, ADR-0194, ADR-0253)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
ExecStart=/opt/foundation-platform/current/scripts/ops/parcel-tile-bake.sh %i
# The timeout below kills the script and the compose client, not the Spark container the Docker
# daemon owns. Spark runs in the Compose project named after this INVOCATION_ID; this removes that
# project's one-off containers and networks and nothing else (root ADR-0128). It runs after every
# exit, a success included, with any installed release's publisher.
# Cleanup by the release this run started from, not the one `current` names when it stops
# (scripts/ops/pinned-cleanup.sh reads it from RuntimeDirectory; root ADR-0270 §3).
ExecStopPost=/opt/foundation-platform/current/scripts/ops/pinned-cleanup.sh parcel-tile-bake.sh
RuntimeDirectory=%N
# Each half is under its job's 120 minutes in Airflow (jobs.v1.json), and both are under the spark
# pool's 165-minute starvation bound (root ADR-0171 §5). Measured nationally (2026-10-14, 202609):
# gate 13.5 + served Gold 59 minutes; GDAL 18 + tippecanoe 49 minutes plus the gates and upload
# (root ADR-0253). One limit for every instance, so a rehearsal is held to what a job is.
TimeoutStartSec=115m
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The journal, the run waiting for its bake and the last baked edition, on the root disk: a few lines.
StateDirectory=foundation-parcel-tile-bake
# Every byte of the bake: the matching verdict, the served handoff, Spark's spill, GDAL's input and
# tippecanoe's temporary files (config/tile-bake-containers.contract.json work_disk.production_root).
ReadWritePaths=/data/foundation-platform/tile-bake
