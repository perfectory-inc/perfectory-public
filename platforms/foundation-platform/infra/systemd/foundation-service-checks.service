[Unit]
Description=Foundation Platform service checks: the live hostnames' edge path from Korea and the pull request CI time trend (root ADR-0207)
After=network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
# Read-only toward everything it asks: Cloudflare's /cdn-cgi/trace and GitHub's public runs API.
# It reads root ADR-0203's script from the control checkout and writes one file foundation-api serves.
ExecStart=/opt/foundation-platform/current/scripts/ops/service-checks.py
TimeoutStartSec=15m
MemoryMax=256M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foundation-platform/service-checks
