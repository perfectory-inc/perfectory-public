[Unit]
Description=Foundation Platform media reconciler: the onbid media in R2 against the Silver index that names it (root ADR-0387)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/media-reconcile.md
X-Foundation-Owner=serving
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=-/etc/foundation-platform/operations-map.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/media-reconcile.sh
# The job list's time_limit_minutes (jobs.v1.json): the index data files added since the last run,
# read by the publisher from the lakehouse, and ~190 list calls (2026-11-15). Generated from the list, not hand-set: `cargo run -p
# foundation-jobs -- generate` (committed_units test).
TimeoutStartSec=10m
TimeoutStopSec=30
# The publisher reading the index and listing the prefix, then a Python process holding the reference
# set (132,000 keys on 2026-11-15) while it reads the listing line by line; counted under
# host_reserved like the other default_pool jobs.
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=460M
MemoryMax=512M
OOMScoreAdjust=500
Environment=FOUNDATION_PLATFORM_DUCKDB_DISK_MAX_BYTES=1073741824
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Its reports and journal, and its textfile for node-exporter.
ReadWritePaths=/var/lib/foundation-platform/media-reconcile /var/lib/foundation-jobs/metrics

[Install]
WantedBy=multi-user.target
