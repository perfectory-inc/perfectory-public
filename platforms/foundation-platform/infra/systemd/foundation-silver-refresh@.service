[Unit]
Description=Foundation Platform Silver refresh of the %i lane: load the newest complete hub.go.kr or VWorld land release in the Bronze ledger, or report it unchanged (root ADR-0169, ADR-0171)
Documentation=file:///opt/foundation-platform/current/docs/runbooks/silver-refresh.md
X-Foundation-Owner=lakehouse
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=foundation-unit-failed@%n.service

[Service]
Type=oneshot
User=foundation-platform
Group=foundation-platform
# Spark (uid 185) shares the work directory through the service account's group.
UMask=0007
WorkingDirectory=/opt/foundation-platform/current
EnvironmentFile=/etc/foundation-platform/recovery.env
EnvironmentFile=/etc/foundation-platform/source-sweep.env
EnvironmentFile=/etc/foundation-platform/map-edit-fold.env
EnvironmentFile=/etc/foundation-platform/lakehouse-reader.env
ExecStart=/opt/foundation-platform/current/scripts/ops/silver-refresh.sh %i
# The timeout below kills the script and the compose client, not the Spark container the Docker
# daemon owns. Spark runs in the Compose project named after this INVOCATION_ID; this removes that
# project's one-off containers and networks and nothing else (root ADR-0128). It runs after every
# exit, a success included, with any installed release's publisher.
# Cleanup by the release this run started from, not the one `current` names when it stops
# (scripts/ops/pinned-cleanup.sh reads it from RuntimeDirectory; root ADR-0270 §3).
ExecStopPost=/opt/foundation-platform/current/scripts/ops/pinned-cleanup.sh silver-refresh.sh
RuntimeDirectory=%N
# The export runs here, as a child of the publisher, not in a container, and so does the
# publisher's DuckDB load (root ADR-0599): this bounds both, one after the other.
# 4G killed the units export on its first lane run (2026-10-10, oom-kill at 4.0G during the export:
# it indexes the nation's titles and basis outlines before it streams the units); 8G throttled it
# at MemoryHigh to 61 minutes (2026-11-21), so the cap is 16G (tools/host-memory-budget.contract.json).
# Memory: rendered from tools/host-memory-budget.contract.json systemd_units (root ADR-0455); do not edit.
MemoryHigh=14745M
MemoryMax=16G
OOMScoreAdjust=500
# The largest national export measured by hand took 18 minutes (unit areas, root ADR-0142); the
# first supervised run of each lane measures the whole run. The bound is what the spark pool's
# starvation check let five scheduled lanes hold (root ADR-0605 removed it) (orchestration/jobs.v1.json timeout_minutes 160,
# root ADR-0171 §5): an hourly fold may already wait 1,200 of its 1,200 minutes, and a lane that
# held its slots longer than the Gold rebuild's 165 would push it over. A lane that needs longer
# reopens that decision; it does not raise this line alone.
TimeoutStartSec=150m
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The lanes' work on the data disk (silver-refresh.sh's state root; the release creates it). The
# root disk is small.
ReadWritePaths=/data/foundation-platform/silver-refresh /var/lib/foundation-platform/silver-refresh-duckdb
